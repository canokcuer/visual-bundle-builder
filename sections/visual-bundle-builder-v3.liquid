    // Savings chip on collapsed dock
    const miniSavings = dock.querySelector('.wa-dock__mini-savings');
    if (miniSavings) {
      if (pricing.discount > 0) {
        miniSavings.textContent = '-' + formatMoney(pricing.discount);
        miniSavings.style.display = 'block';
      } else {
        miniSavings.style.display = 'none';
      }
    }

    // Savings chip (expanded view) — colors sync with progress bar tier
    const dockSavingsChip = dock.querySelector('.wa-dock__savings-chip');
    if (dockSavingsChip) {
      if (pricing.discount > 0) {
