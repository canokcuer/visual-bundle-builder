  // ============================================
  // SYNERGY MAP RENDERER (v2)
  // ============================================
  const SynergyMapRenderer = {
    // Regular pentagon: center (200, 145), radius 100
    // Angles: -π/2 + i * 2π/5 for i = 0..4
    POSITIONS: {
      'dailyglow':    { x: 200, y: 45 },   // Top center
      'mindfuel':     { x: 295, y: 114 },   // Right top
      'dreamglow':    { x: 259, y: 226 },   // Right bottom
      'thechill':     { x: 141, y: 226 },   // Left bottom
      'reset-button': { x: 105, y: 114 }    // Left top
    },
    NODE_RADIUS: 30,
    VIEW_W: 400,
    VIEW_H: 300,

    // Find the best unselected node to recommend (most new synergies)
    getBestNextHandle(selectedHandles) {
      const allHandles = Object.keys(this.POSITIONS);
      const unselected = allHandles.filter(h => !selectedHandles.includes(h));
      if (selectedHandles.length === 0 || unselected.length === 0) return null;

      let best = null, bestCount = 0;
      unselected.forEach(candidate => {
        let count = 0;
        selectedHandles.forEach(sel => {
          const key = [candidate, sel].sort().join('+');
          if (SYNERGY_CONNECTIONS[key]) count++;
        });
        if (count > bestCount) { bestCount = count; best = candidate; }
      });
      return bestCount > 0 ? best : null;
    },

    render(container, selectedHandles) {
      const svg = container.querySelector('.wa-synergy-map__svg');
      const labelsContainer = container.querySelector('.wa-synergy-map__labels');
      if (!svg || !labelsContainer) return;

      svg.classList.remove('wa-synergy-map--spotlight');
      svg.innerHTML = '';
      labelsContainer.innerHTML = '';
      container.style.display = 'block';

      const bestNext = this.getBestNextHandle(selectedHandles);

      // Render connections (behind nodes) — only between selected products
      const connections = this.getActiveConnections(selectedHandles);
      connections.forEach(conn => this.renderConnection(svg, conn));

      // Render all product nodes
      Object.entries(this.POSITIONS).forEach(([handle, pos]) => {
        const isSelected = selectedHandles.includes(handle);
        const isBestNext = handle === bestNext;
        this.renderNode(svg, handle, pos, isSelected, isBestNext);
        this.renderBadge(labelsContainer, handle, pos, isSelected);
      });

      // Empty state hint
      this.renderEmptyState(container, selectedHandles);

      this.bindNodeClickHandlers(svg);
    },

    renderEmptyState(container, selectedHandles) {
      const existing = container.querySelector('.wa-synergy-empty');
      if (existing) existing.remove();
      if (selectedHandles.length >= 2) return;
      const hint = document.createElement('div');
      hint.className = 'wa-synergy-empty';
      hint.textContent = selectedHandles.length === 0
        ? 'Ürün ekleyerek sinerjileri keşfedin'
        : 'Bir ürün daha ekleyin — sinerjiler görünsün';
      const scrollArea = container.querySelector('.wa-synergy-map__scroll');
      if (scrollArea) scrollArea.after(hint);
    },

    renderBadge(labelsContainer, handle, pos, isSelected) {
      const badge = document.createElement('div');
      badge.className = `wa-synergy-badge ${isSelected ? 'wa-synergy-badge--added' : 'wa-synergy-badge--add'}`;
      badge.setAttribute('data-badge-handle', handle);
      const offset = this.NODE_RADIUS * 0.6;
      badge.style.left = `${((pos.x + offset) / this.VIEW_W) * 100}%`;
      badge.style.top = `${((pos.y - offset) / this.VIEW_H) * 100}%`;
      badge.innerHTML = isSelected
        ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>'
        : '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>';
      labelsContainer.appendChild(badge);
    },

    handleNodeOrBadgeClick(handle, isSelected) {
      const product = handleToProductMap.get(handle);

      // Instant visual feedback on pentagon nodes before addItem/removeItem
      if (!isSelected) {
        document.querySelectorAll(`.wa-synergy-node[data-handle="${handle}"]`).forEach(node => {
          node.classList.remove('wa-synergy-node--inactive', 'wa-synergy-node--best-next');
          node.classList.add('wa-synergy-node--selected');
        });
        document.querySelectorAll(`.wa-synergy-badge[data-badge-handle="${handle}"]`).forEach(badge => {
          badge.classList.remove('wa-synergy-badge--add');
          badge.classList.add('wa-synergy-badge--added');
          badge.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        });
      }

      if (isSelected) {
        const item = state.items.find(i => matchHandle(i.title) === handle);
        if (item) removeItem(item.id);
      } else if (product) {
        const card = document.querySelector(`.wa-product-card[data-product-handle="${handle}"]`);
        if (card) {
          addItem({
            id: card.dataset.productId,
            handle: card.dataset.productHandle,
            title: card.dataset.productTitle,
            price: parseInt(card.dataset.productPrice),
            image: card.dataset.productImage,
            variantId: card.dataset.variantId,
            url: card.dataset.productUrl,
            quantity: 1
          });
        }
      }
    },

    bindNodeClickHandlers(svg) {
      svg.querySelectorAll('.wa-synergy-node').forEach(node => {
        node.addEventListener('click', (e) => {
          e.stopPropagation();
          const handle = node.getAttribute('data-handle');
          if (!handle) return;
          this.handleNodeOrBadgeClick(handle, node.classList.contains('wa-synergy-node--selected'));
        });
      });

      const labelsContainer = svg.parentElement.querySelector('.wa-synergy-map__labels');
      if (labelsContainer) {
        labelsContainer.querySelectorAll('.wa-synergy-badge').forEach(badge => {
          badge.addEventListener('click', (e) => {
            e.stopPropagation();
            const handle = badge.getAttribute('data-badge-handle');
            if (!handle) return;
            this.handleNodeOrBadgeClick(handle, badge.classList.contains('wa-synergy-badge--added'));
          });
        });
      }
    },

    getActiveConnections(selectedHandles) {
      const connections = [];
      for (let i = 0; i < selectedHandles.length; i++) {
        for (let j = i + 1; j < selectedHandles.length; j++) {
          const h1 = selectedHandles[i], h2 = selectedHandles[j];
          const key = [h1, h2].sort().join('+');
          const conn = SYNERGY_CONNECTIONS[key];
          if (conn) {
            connections.push({
              ...conn,
              from: this.POSITIONS[h1],
              to: this.POSITIONS[h2],
              handles: [h1, h2]
            });
          }
        }
      }
      return connections;
    },

    renderNode(svg, handle, pos, isSelected, isBestNext) {
      const product = handleToProductMap.get(handle);
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      let cls = 'wa-synergy-node';
      if (isSelected) cls += ' wa-synergy-node--selected';
      else if (isBestNext) cls += ' wa-synergy-node--best-next';
      else cls += ' wa-synergy-node--inactive';
      g.setAttribute('class', cls);
      g.setAttribute('data-handle', handle);

      // Glow ring (for best-next recommendation)
      const glow = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      glow.setAttribute('cx', pos.x);
      glow.setAttribute('cy', pos.y);
      glow.setAttribute('r', this.NODE_RADIUS + 4);
      glow.setAttribute('class', 'wa-synergy-node__glow');
      g.appendChild(glow);

      // Background circle
      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('cx', pos.x);
      circle.setAttribute('cy', pos.y);
      circle.setAttribute('r', this.NODE_RADIUS);
      circle.setAttribute('class', 'wa-synergy-node__bg');
      g.appendChild(circle);

      // Clip path for image
      const clipId = `clip-${handle}-${Date.now()}`;
      const clipPath = document.createElementNS('http://www.w3.org/2000/svg', 'clipPath');
      clipPath.setAttribute('id', clipId);
      const clipCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      clipCircle.setAttribute('cx', pos.x);
      clipCircle.setAttribute('cy', pos.y);
      clipCircle.setAttribute('r', this.NODE_RADIUS - 2);
      clipPath.appendChild(clipCircle);
      svg.appendChild(clipPath);

      // Product image
      if (product && product.image) {
        const img = document.createElementNS('http://www.w3.org/2000/svg', 'image');
        img.setAttribute('href', product.image);
        img.setAttribute('x', pos.x - this.NODE_RADIUS + 2);
        img.setAttribute('y', pos.y - this.NODE_RADIUS + 2);
        img.setAttribute('width', (this.NODE_RADIUS - 2) * 2);
        img.setAttribute('height', (this.NODE_RADIUS - 2) * 2);
        img.setAttribute('clip-path', `url(#${clipId})`);
        img.setAttribute('preserveAspectRatio', 'xMidYMid slice');
        g.appendChild(img);
      }

      // Product name label below node
      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('x', pos.x);
      text.setAttribute('y', pos.y + this.NODE_RADIUS + 14);
      text.setAttribute('text-anchor', 'middle');
      text.setAttribute('class', 'wa-synergy-node__label');
      text.textContent = SYNERGY_MAP[handle]?.name || handle;
      g.appendChild(text);

      svg.appendChild(g);
    },

    renderConnection(svg, conn) {
      const { from, to, color, strength, handles } = conn;

      // Gentle curve between nodes
      const midX = (from.x + to.x) / 2;
      const midY = (from.y + to.y) / 2;
      const dx = to.x - from.x, dy = to.y - from.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      const perpX = -dy / dist * 25;
      const perpY = dx / dist * 25;
      const ctrlX = midX + perpX, ctrlY = midY + perpY;

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', `M ${from.x} ${from.y} Q ${ctrlX} ${ctrlY} ${to.x} ${to.y}`);
      path.setAttribute('class', `wa-synergy-line wa-synergy-line--${strength} wa-synergy-line--visible`);
      path.setAttribute('stroke', color);
      path.setAttribute('fill', 'none');
      if (handles) path.setAttribute('data-handles', handles.slice().sort().join('+'));
      svg.insertBefore(path, svg.firstChild);
    },

    renderSynergyList(container, selectedHandles) {
      const listContainer = container.querySelector('.wa-synergy-list');
      if (!listContainer) return;

      const connections = this.getActiveConnections(selectedHandles);

      if (connections.length === 0) {
        listContainer.innerHTML = '';
        return;
      }

      let html = '';
      connections.forEach(conn => {
        const key = conn.handles.sort().join('+');
        const expl = SYNERGY_EXPLANATIONS[key];
        if (expl) {
          const [h1, h2] = conn.handles;
          const p1 = handleToProductMap.get(h1);
          const p2 = handleToProductMap.get(h2);
          const img1 = p1?.image ? `<img src="${p1.image}" alt="" width="20" height="20" class="wa-synergy-list-avatar">` : '';
          const img2 = p2?.image ? `<img src="${p2.image}" alt="" width="20" height="20" class="wa-synergy-list-avatar">` : '';
          const name1 = SYNERGY_MAP[h1]?.name || h1;
          const name2 = SYNERGY_MAP[h2]?.name || h2;
          html += `<div class="wa-synergy-list-item" data-handles="${h1},${h2}">
              <div class="wa-synergy-list-avatars">${img1}${img2}</div>
              <div class="wa-synergy-list-text">
                <span class="wa-synergy-list-title">${expl.title}</span>
                <span class="wa-synergy-list-benefit">— ${expl.benefit}</span>
                <span class="wa-synergy-list-names">${name1} + ${name2}</span>
              </div>
            </div>`;
        }
      });

      listContainer.innerHTML = html;
      this.bindSpotlight(container);
    },

    clearSpotlight(container) {
      const svg = container.querySelector('.wa-synergy-map__svg');
      if (svg) svg.classList.remove('wa-synergy-map--spotlight');
      container.querySelectorAll('.wa-synergy-list-item--active').forEach(i => i.classList.remove('wa-synergy-list-item--active'));
      container.querySelectorAll('.wa-synergy-node--spotlight').forEach(n => n.classList.remove('wa-synergy-node--spotlight'));
      container.querySelectorAll('.wa-synergy-line--spotlight').forEach(l => l.classList.remove('wa-synergy-line--spotlight'));
    },

    bindSpotlight(container) {
      const svg = container.querySelector('.wa-synergy-map__svg');
      const listContainer = container.querySelector('.wa-synergy-list');
      if (!svg || !listContainer) return;
      const self = this;

      // Use event delegation on list container — no per-item listeners needed
      listContainer.onclick = function(e) {
        const item = e.target.closest('.wa-synergy-list-item');
        if (!item) return;
        const handles = (item.dataset.handles || '').split(',');
        const wasActive = item.classList.contains('wa-synergy-list-item--active');
        self.clearSpotlight(container);
        if (wasActive) return;

        item.classList.add('wa-synergy-list-item--active');
        svg.classList.add('wa-synergy-map--spotlight');

        handles.forEach(h => {
          const node = svg.querySelector(`.wa-synergy-node[data-handle="${h}"]`);
          if (node) node.classList.add('wa-synergy-node--spotlight');
        });

        const key = handles.slice().sort().join('+');
        svg.querySelectorAll('.wa-synergy-line').forEach(line => {
          if (line.getAttribute('data-handles') === key) line.classList.add('wa-synergy-line--spotlight');
        });
      };

      // Bind SVG dismiss listener only once — use a flag to prevent accumulation
      if (!svg._spotlightBound) {
        svg._spotlightBound = true;
        svg.addEventListener('click', (e) => {
          if (!e.target.closest('.wa-synergy-node')) self.clearSpotlight(container);
        });
      }
    },

    patchUpdate(container, selectedHandles) {
      const svg = container.querySelector('.wa-synergy-map__svg');
      const labelsContainer = container.querySelector('.wa-synergy-map__labels');
      if (!svg || !labelsContainer) return;

      // If SVG is empty (first render), fall back to full render
      if (!svg.querySelector('.wa-synergy-node')) {
        this.render(container, selectedHandles);
        this.renderSynergyList(container, selectedHandles);
        return;
      }

      svg.classList.remove('wa-synergy-map--spotlight');
      const bestNext = this.getBestNextHandle(selectedHandles);

      // 1. Patch node classes (no DOM creation, just class swaps)
      Object.entries(this.POSITIONS).forEach(([handle]) => {
        const isSelected = selectedHandles.includes(handle);
        const isBestNext = handle === bestNext;
        const node = svg.querySelector(`.wa-synergy-node[data-handle="${handle}"]`);
        if (node) {
          node.classList.toggle('wa-synergy-node--selected', isSelected);
          node.classList.toggle('wa-synergy-node--best-next', !isSelected && isBestNext);
          node.classList.toggle('wa-synergy-node--inactive', !isSelected && !isBestNext);
        }

        // 2. Patch badge icon/class
        const badge = labelsContainer.querySelector(`.wa-synergy-badge[data-badge-handle="${handle}"]`);
        if (badge) {
          badge.classList.toggle('wa-synergy-badge--added', isSelected);
          badge.classList.toggle('wa-synergy-badge--add', !isSelected);
          badge.innerHTML = isSelected
            ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>'
            : '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>';
        }
      });

      // 3. Patch connections: remove old lines, add current
      svg.querySelectorAll('.wa-synergy-line').forEach(l => l.remove());
      const connections = this.getActiveConnections(selectedHandles);
      connections.forEach(conn => this.renderConnection(svg, conn));

      // 4. Patch empty state
      this.renderEmptyState(container, selectedHandles);

      // 5. Update synergy list
      this.renderSynergyList(container, selectedHandles);
    },

    update(selectedHandles) {
      const dockMap = dock?.querySelector('.wa-dock__synergy-achievements');
      const sidebarMap = sidebar?.querySelector('.wa-synergy-achievements');
      if (dockMap) this.patchUpdate(dockMap, selectedHandles);
      if (sidebarMap) this.patchUpdate(sidebarMap, selectedHandles);
    }
  };

  // ============================================
  // PRICING & SYNERGY LOGIC
  // Tier and promo discounts stack multiplicatively, matching Shopify's
  // default behavior for two combinable order-percentage discounts.
  // ============================================
  function calculatePricing() {
    const totalQty = getTotalQuantity();
    const bundleTier = Math.min(totalQty, 5);
    const bundleRate = bundleTier > 0 ? (SYNERGY_CONFIG[bundleTier]?.discount || 0) : 0;
    let subtotal = 0, tierDiscount = 0;

    state.items.forEach(item => {
      const qty = item.quantity || 1;
      const itemSub = item.price * qty;
      subtotal += itemSub;
      tierDiscount += Math.round(itemSub * bundleRate);
    });

    const afterTier = subtotal - tierDiscount;
    const promoRate = state.activePromo ? state.activePromo.percent / 100 : 0;
    const promoDiscount = Math.round(afterTier * promoRate);
    const total = afterTier - promoDiscount;

    return {
      subtotal,
      tierDiscount,
      promoDiscount,
      discount: tierDiscount + promoDiscount, // total savings (existing field — kept for compat)
      total
    };
  }

  function getSynergyExplanation() {
    if (state.items.length === 0) return null;
    if (state.items.length === 1) {
      const h = matchHandle(state.items[0].title);
      return SINGLE_PRODUCT_BENEFITS[h] || null;
    }
    const key = state.items.map(i => matchHandle(i.title)).sort().join('+');
    return SYNERGY_EXPLANATIONS[key] || { title: `${state.items.length}'li Paket`, benefit: `%${Math.round(SYNERGY_CONFIG[Math.min(state.items.length, 5)]?.discount * 100 || 0)} indirim`, detail: 'Urunler birlikte daha etkili.' };
  }

  function getRecommendation() {
    if (state.items.length === 0 || state.items.length >= 5) return null;
    const addedHandles = state.items.map(i => matchHandle(i.title));
    const recs = RECOMMENDATIONS[addedHandles[0]] || [];
    for (const r of recs) if (!addedHandles.includes(r.handle)) return r;
    for (const h of Object.keys(SYNERGY_MAP)) if (!addedHandles.includes(h)) return { handle: h, bundle: 'Ritüeli Tamamla', reason: 'İndirim seviyenizi artırın.' };
    return null;
  }

  function getRitualGuide() {
    if (state.items.length === 0) return null;
    const guide = [];
    const items = state.items.map(i => ({ ...i, handle: matchHandle(i.title), syn: SYNERGY_MAP[matchHandle(i.title)] }));
    items.filter(i => i.syn?.category === 'morning').forEach(p => guide.push({ time: 'Sabah', product: p.syn?.name || p.title, text: p.syn?.tip || '' }));
    items.filter(i => i.syn?.category === 'noon').forEach(p => guide.push({ time: 'Öğle', product: p.syn?.name || p.title, text: p.syn?.tip || '' }));
    items.filter(i => i.syn?.category === 'night').forEach(p => guide.push({ time: 'Akşam', product: p.syn?.name || p.title, text: p.syn?.tip || '' }));
    return guide.length > 0 ? guide : null;
  }

  // ============================================
  // SHOPIFY CART API
  // ============================================
  async function addToShopifyCart(variantId, qty = 1) {
    try {
      const res = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: qty }] }) });
      return res.ok;
    } catch { return false; }
  }

  async function removeFromShopifyCart(variantId) {
    try {
      const res = await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: variantId.toString(), quantity: 0 }) });
      return res.ok;
    } catch { return false; }
  }

  async function updateShopifyCartQty(variantId, qty) {
    try {
      const res = await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: variantId.toString(), quantity: qty }) });
      return res.ok;
    } catch { return false; }
  }

  // ============================================
  // STATE MANAGEMENT
  // ============================================
  function addItem(productData, qty = 1) {
    if (addInFlight.has(productData.id)) return false;
    const existing = state.items.find(i => i.id === productData.id);
    if (existing) { removeItem(productData.id); return false; }
    if (state.items.length >= 5) { vibrate([30, 20, 30]); return false; }

    // Optimistic UI — add to state immediately, sync in background
    addInFlight.add(productData.id);
    state.items.push({ ...productData, quantity: qty });
    vibrate(10);
    updateUI();
    checkAchievements();

    if (state.isMobile && !state.isExpanded) {
      setTimeout(() => { state.isExpanded = true; dock.classList.add('wa-dock--expanded'); setBodyScroll(true); }, 400);
    }

    // Fire network call in background with rollback on failure
    addToShopifyCart(productData.variantId, qty).then(success => {
      addInFlight.delete(productData.id);
      if (!success) {
        state.items = state.items.filter(i => i.id !== productData.id);
        updateUI();
        showAddFailedToast(productData.title);
      }
    }).catch(() => {
      addInFlight.delete(productData.id);
      state.items = state.items.filter(i => i.id !== productData.id);
      updateUI();
    });

    return true;
  }

  async function removeItem(productId) {
    const item = state.items.find(i => i.id === productId);
    // Optimistic UI — remove instantly, sync in background
    state.items = state.items.filter(i => i.id !== productId);
    vibrate(10);
    updateUI();
    if (item) removeFromShopifyCart(item.variantId);
  }

  function animateQtyRoll(productId, direction) {
    document.querySelectorAll(`[data-qty-minus="${productId}"], [data-qty-plus="${productId}"]`).forEach(btn => {
      const valueSpan = btn.parentElement?.querySelector('[class$="item-qty-value"]');
      if (!valueSpan) return;
      const inner = valueSpan.firstElementChild;
      if (!inner) return;
      const from = direction > 0 ? '100%' : '-100%';
      inner.style.transform = `translateY(${from})`;
      requestAnimationFrame(() => { inner.style.transform = 'translateY(0)'; });
    });
  }

  function updateQuantity(productId, delta) {
    const item = state.items.find(i => i.id === productId);
    if (!item) return;

    const newQty = item.quantity + delta;
    if (newQty <= 0) {
      removeItem(productId);
    } else {
      const clampedQty = Math.min(10, newQty);
      const oldQty = item.quantity;
      item.quantity = clampedQty;
      vibrate(5);
      updateUI();
      animateQtyRoll(productId, delta);

      updateShopifyCartQty(item.variantId, clampedQty).then(success => {
        if (!success) {
          item.quantity = oldQty;
          updateUI();
        }
      });
    }
  }

  // ============================================
  // ACHIEVEMENTS
  // ============================================
  function checkAchievements() {
    // Generic achievements are disabled - synergy connections shown in synergy list instead
    // Keep tracking state for potential future use
    Object.values(ACHIEVEMENTS).forEach(ach => {
      if (!achievementState.unlocked.has(ach.id) && ach.condition(state)) {
        achievementState.unlocked.add(ach.id);
        // Don't push to pending queue - no notifications for generic achievements
      }
    });
    // Synergy achievements are displayed via the synergy list in renderSynergyList
    updateAchievementDisplay();
  }

  function showAddFailedToast(productTitle) {
    const toast = document.createElement('div');
    toast.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#ef4444;color:#fff;padding:10px 20px;border-radius:8px;font-size:14px;z-index:99999;opacity:0;transition:opacity 0.3s ease;pointer-events:none;';
    toast.textContent = (productTitle || 'Ürün') + ' eklenemedi. Tekrar deneyin.';
    document.body.appendChild(toast);
    requestAnimationFrame(() => { toast.style.opacity = '1'; });
    setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 2500);
  }

  function processAchievementQueue() {
    if (achievementState.pending.length === 0) return;
    const ach = achievementState.pending.shift();
    showAchievementUnlock(ach);
  }

  function showAchievementUnlock(ach) {
    // Update achievement icons in merged container
    updateAchievementDisplay();
    showAchievementUnlockInBox(ach);

    // Also show floating notification
    const notif = document.createElement('div');
    notif.className = 'wa-achievement-notification';
    notif.innerHTML = `<div class="wa-achievement-notification__icon wa-achievement-notification__icon--locked">${ICONS.lock}</div><div><span class="wa-achievement-notification__label">Kilidi Acildi!</span><span class="wa-achievement-notification__title">${ach.title}</span></div>`;
    document.body.appendChild(notif);

    requestAnimationFrame(() => {
      notif.classList.add('wa-achievement-notification--visible');
      setTimeout(() => {
        const icon = notif.querySelector('.wa-achievement-notification__icon');
        icon.classList.remove('wa-achievement-notification__icon--locked');
        icon.classList.add('wa-achievement-notification__icon--unlocking');
        icon.innerHTML = ICONS.unlock;
        createMiniConfetti(notif);
      }, 300);
    });

    setTimeout(() => {
      notif.classList.add('wa-achievement-notification--hiding');
      setTimeout(() => { notif.remove(); setTimeout(processAchievementQueue, 200); }, 300);
    }, 2500);
  }

  function createMiniConfetti(el) {
    const rect = el.getBoundingClientRect();
    const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
    const colors = ['#FFD700', '#FF6B6B', '#4ECDC4', '#45B7D1', '#96E6A1'];
    for (let i = 0; i < 12; i++) {
      const c = document.createElement('div');
      c.className = 'wa-confetti';
      c.style.left = cx + 'px'; c.style.top = cy + 'px';
      c.style.background = colors[Math.floor(Math.random() * colors.length)];
      const angle = (Math.PI * 2 * i) / 12, vel = 30 + Math.random() * 40;
      c.style.setProperty('--tx', Math.cos(angle) * vel + 'px');
      c.style.setProperty('--ty', Math.sin(angle) * vel + 'px');
      c.style.setProperty('--rot', Math.random() * 720 - 360 + 'deg');
      particles.appendChild(c);
      setTimeout(() => c.remove(), 1000);
    }
  }

  function updateAchievementDisplay() {
    const unlocked = achievementState.unlocked.size;

    [sidebar, dock].forEach(container => {
      if (!container) return;
      // Update achievement icons in merged synergy-achievements container
      const merged = container.querySelector('.wa-synergy-achievements, .wa-dock__synergy-achievements');
      if (!merged) return;

      // Show merged container when there are items
      merged.style.display = state.items.length > 0 ? 'block' : 'none';

      // Update achievement icons
      const icons = merged.querySelectorAll('.wa-achievement-icon');
      icons.forEach(icon => {
        const achId = icon.dataset.achievement;
        const isUnlocked = achievementState.unlocked.has(achId);
        icon.classList.toggle('wa-achievement-icon--unlocked', isUnlocked);
      });
    });
  }

  function showAchievementUnlockInBox(achievement) {
    [sidebar, dock].forEach(container => {
      if (!container) return;
      const merged = container.querySelector('.wa-synergy-achievements, .wa-dock__synergy-achievements');
      if (!merged) return;

      // Find the icon and animate it
      const icon = merged.querySelector(`.wa-achievement-icon[data-achievement="${achievement.id}"]`);
      if (icon) {
        icon.classList.add('wa-achievement-icon--unlocking');
        setTimeout(() => icon.classList.remove('wa-achievement-icon--unlocking'), 600);
      }

      // Show unlock box
      const unlockBox = merged.querySelector('.wa-achievement-unlock-box');
      if (unlockBox) {
        unlockBox.style.display = 'block';
        unlockBox.innerHTML = `
          <div class="wa-achievement-unlock-box__header">
            <span class="wa-achievement-unlock-box__emoji">${achievement.emoji || '⭐'}</span>
            <span>${achievement.title} Acildi!</span>
          </div>
          <p class="wa-achievement-unlock-box__text">${achievement.description}</p>
        `;
        // Auto-hide after 4 seconds
        setTimeout(() => {
          unlockBox.style.display = 'none';
        }, 4000);
      }
    });
  }

  // ============================================
  // UNIFIED RENDER FUNCTIONS (DRY)
  // ============================================
  function renderItemHTML(item, variant) {
    const handle = matchHandle(item.title);
    const benefit = SYNERGY_MAP[handle]?.benefit || '';
    const prefix = variant === 'dock' ? 'wa-dock' : 'wa-sidebar';
    return `<div class="${prefix}__item" data-product-id="${item.id}">
      <a href="${item.url || '/products/' + item.handle}" class="${prefix}__item-link">
        <img src="${item.image}" alt="${item.title}" class="${prefix}__item-image">
        <div class="${prefix}__item-info">
          <h4 class="${prefix}__item-title">${SYNERGY_MAP[handle]?.name || item.title}</h4>
          ${benefit ? `<p class="${prefix}__item-benefit">${benefit}</p>` : ''}
        </div>
      </a>
      <div class="${prefix}__item-controls">
        <div class="${prefix}__item-qty">
          <button class="${prefix}__item-qty-btn" data-qty-minus="${item.id}">-</button>
          <span class="${prefix}__item-qty-value" style="display:inline-block;overflow:hidden;height:1.2em;vertical-align:middle;position:relative;"><span style="display:block;transition:transform 0.2s ease;">${item.quantity}</span></span>
          <button class="${prefix}__item-qty-btn" data-qty-plus="${item.id}">+</button>
        </div>
        <button class="${prefix}__item-remove" data-remove="${item.id}">${ICONS.close}</button>
      </div>
    </div>`;
  }

  // ============================================
  // PROGRESS BAR — Shadow DOM Web Component
  // ============================================
  // Shadow DOM encapsulates styles so Shopify theme CSS cannot interfere.
  if (!customElements.get('wa-progress-bar')) {
    class WaProgressBar extends HTMLElement {
      constructor() {
        super();
        this.attachShadow({ mode: 'open' });
      }

      connectedCallback() {
        const isMini = this.hasAttribute('mini');
        const trackH = isMini ? 6 : 10;
        const r = isMini ? 3 : 5;

        this.shadowRoot.innerHTML = `
          <style>
            :host { display:block; ${isMini ? 'margin:4px 0 2px 0' : 'margin-top:8px'}; position:relative; }
            .track { position:relative; height:${trackH}px; background:#e5e5e5; border-radius:${r}px; overflow:hidden; }
            .fill  { position:absolute; top:0; left:0; height:100%; border-radius:${r}px; transition:width 0.5s ease, background 0.5s ease; width:0%; }
            .seg   { position:absolute; top:0; width:2px; height:100%; background:rgba(255,255,255,0.7); transform:translateX(-50%); z-index:1; }
            .labels { position:relative; height:18px; margin-top:4px; }
            .lbl   { position:absolute; transform:translateX(-50%); font-size:0.6rem; font-weight:600; color:#a3a3a3; }
            .lbl-end { position:absolute; right:0; font-size:0.6rem; font-weight:600; color:#a3a3a3; }
          </style>
          <div class="track">
            <div class="fill"></div>
            <div class="seg" style="left:25%"></div>
            <div class="seg" style="left:50%"></div>
            <div class="seg" style="left:75%"></div>
          </div>
          ${!isMini ? `<div class="labels">
            <span class="lbl" style="left:25%">%10</span>
            <span class="lbl" style="left:50%">%30</span>
            <span class="lbl" style="left:75%">%33</span>
            <span class="lbl-end">%35</span>
          </div>` : ''}`;

        this._fill = this.shadowRoot.querySelector('.fill');
      }

      setProgress(level) {
        if (!this._fill) return;
        const TIER_GRADIENTS = [
          'linear-gradient(90deg,#d4d4d4,#a3a3a3)',
          'linear-gradient(90deg,#d4d4d4,#a3a3a3)',
          'linear-gradient(90deg,#22c55e,#16a34a)',
          'linear-gradient(90deg,#06b6d4,#0891b2)',
          'linear-gradient(90deg,#8b5cf6,#7c3aed)',
          'linear-gradient(90deg,#f59e0b,#d97706)'
        ];
        const pct = level <= 1 ? 0 : (level - 1) * 25;
        this._fill.style.width = pct + '%';
        this._fill.style.background = TIER_GRADIENTS[Math.min(level, 5)] || TIER_GRADIENTS[0];
      }
    }
    customElements.define('wa-progress-bar', WaProgressBar);
  }

  function updateStepIndicators(el, level) {
    if (el && typeof el.setProgress === 'function') el.setProgress(level);
  }

  // ============================================
  // TIER CELEBRATION
  // ============================================
  function showTierCelebration(tier, synergy, pricing) {
    const existing = document.querySelector('.wa-tier-celebration');
    if (existing) existing.remove();

    const TIER_THEMES = {
      2: { gradient: 'linear-gradient(135deg,#22c55e,#16a34a)', emoji: '🌿', glow: 'rgba(34,197,94,0.3)', label: '%10 İndirim' },
      3: { gradient: 'linear-gradient(135deg,#06b6d4,#0891b2)', emoji: '🌊', glow: 'rgba(6,182,212,0.3)', label: '%30 İndirim' },
      4: { gradient: 'linear-gradient(135deg,#8b5cf6,#7c3aed)', emoji: '💎', glow: 'rgba(139,92,246,0.3)', label: '%33 İndirim' },
      5: { gradient: 'linear-gradient(135deg,#f59e0b,#d97706)', emoji: '👑', glow: 'rgba(245,158,11,0.3)', label: 'MAX %35 İndirim' }
    };
    const t = TIER_THEMES[tier] || TIER_THEMES[2];

    // Overlay
    const overlay = document.createElement('div');
    overlay.className = 'wa-tier-celebration';
    overlay.style.cssText = 'position:fixed;inset:0;z-index:10001;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0);transition:background 0.3s ease;pointer-events:none;';

    // Card
    const card = document.createElement('div');
    card.style.cssText = `position:relative;background:#fff;border-radius:20px;padding:32px 40px;text-align:center;transform:scale(0.3);opacity:0;transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1),opacity 0.3s ease;box-shadow:0 20px 60px rgba(0,0,0,0.15),0 0 80px ${t.glow};max-width:280px;width:90%;`;

    // Accent bar at top of card
    const accent = document.createElement('div');
    accent.style.cssText = `position:absolute;top:0;left:0;right:0;height:4px;border-radius:20px 20px 0 0;background:${t.gradient};`;
    card.appendChild(accent);

    // Emoji
    const emojiEl = document.createElement('div');
    emojiEl.textContent = t.emoji;
    emojiEl.style.cssText = 'font-size:3rem;margin-bottom:8px;animation:wa-cele-bounce 0.6s ease 0.3s both;';
    card.appendChild(emojiEl);

    // Discount label
    const labelEl = document.createElement('div');
    labelEl.textContent = t.label;
    labelEl.style.cssText = `font-size:1.5rem;font-weight:800;background:${t.gradient};-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:4px;`;
    card.appendChild(labelEl);

    // Savings amount
    if (pricing && pricing.discount > 0) {
      const savingsEl = document.createElement('div');
      savingsEl.textContent = formatMoney(pricing.discount) + ' kazandın';
      savingsEl.style.cssText = 'font-size:0.85rem;color:#737373;font-weight:500;';
      card.appendChild(savingsEl);
    }

    overlay.appendChild(card);

    // Confetti particles
    const colors = ['#22c55e','#06b6d4','#8b5cf6','#f59e0b','#ef4444','#ec4899'];
    for (let i = 0; i < 40; i++) {
      const p = document.createElement('div');
      const size = Math.random() * 8 + 4;
      const angle = (Math.PI * 2 * i) / 40;
      const dist = Math.random() * 120 + 60;
      const tx = Math.cos(angle) * dist;
      const ty = Math.sin(angle) * dist - 40;
      const rot = Math.random() * 360;
      const color = colors[Math.floor(Math.random() * colors.length)];
      const shape = Math.random() > 0.5 ? '50%' : '2px';
      p.style.cssText = `position:absolute;width:${size}px;height:${size}px;background:${color};border-radius:${shape};top:50%;left:50%;opacity:0;pointer-events:none;z-index:-1;animation:wa-cele-confetti 0.8s cubic-bezier(0.25,0.46,0.45,0.94) 0.15s both;--tx:${tx}px;--ty:${ty}px;--rot:${rot}deg;`;
      overlay.appendChild(p);
    }

    // Inject keyframes (once)
    if (!document.getElementById('wa-cele-keyframes')) {
      const style = document.createElement('style');
      style.id = 'wa-cele-keyframes';
      style.textContent = `
        @keyframes wa-cele-bounce { 0%{transform:scale(0) rotate(-10deg)} 50%{transform:scale(1.3) rotate(5deg)} 100%{transform:scale(1) rotate(0)} }
        @keyframes wa-cele-confetti { 0%{transform:translate(0,0) rotate(0) scale(1);opacity:1} 100%{transform:translate(var(--tx),var(--ty)) rotate(var(--rot)) scale(0);opacity:0} }
      `;
      document.head.appendChild(style);
    }

    document.body.appendChild(overlay);

    // Animate in
    requestAnimationFrame(() => {
      overlay.style.background = 'rgba(0,0,0,0.12)';
      card.style.transform = 'scale(1)';
      card.style.opacity = '1';
    });

    // Animate out
    setTimeout(() => {
      card.style.transform = 'scale(0.8)';
      card.style.opacity = '0';
      overlay.style.background = 'rgba(0,0,0,0)';
      setTimeout(() => overlay.remove(), 400);
    }, 1500);
  }

  function celebrateTierUnlock(tier, synergy, pricing) {
    // Pulse synergy text elements
    const pulseTargets = [
      dock?.querySelector('.wa-dock__synergy-badge'),
      dock?.querySelector('.wa-dock__discount-steps-current'),
      sidebar?.querySelector('.wa-sidebar__synergy-text')
    ].filter(Boolean);

    pulseTargets.forEach(el => {
      el.style.animation = 'wa-tier-pulse 0.5s ease';
      setTimeout(() => { el.style.animation = ''; }, 2000);
    });

    showTierCelebration(tier, synergy, pricing);
  }

  // ============================================
  // PROMO CODE DETECTION & BANNER (v3)
  // ============================================
  // Resolve the active promo from URL param first, then fall back to /cart.js
  // (cookie-set codes from /discount/CODE redirects appear in cart_level_discount_applications
  //  once at least one line item exists). Idempotent — safe to call multiple times.
  async function detectActivePromo() {
    if (state.activePromo) return; // already detected
    if (PROMO_MAP.size === 0) return; // no codes configured

    // 1. URL param (?promo=CODE)
    try {
      const urlPromo = new URLSearchParams(window.location.search).get('promo');
      if (urlPromo) {
        const hit = PROMO_MAP.get(urlPromo.toUpperCase());
        if (hit) { state.activePromo = hit; return; }
      }
    } catch (_) {}

    // 2. /cart.js fallback (only surfaces codes once cart has line items)
    try {
      const res = await fetch('/cart.js');
      if (!res.ok) return;
      const cart = await res.json();
      const titles = []
        .concat((cart.cart_level_discount_applications || []).map(d => d.title || ''))
        .concat((cart.discount_codes || []).map(d => d.code || ''));
      for (const t of titles) {
        if (!t) continue;
        const hit = PROMO_MAP.get(String(t).toUpperCase());
        if (hit) { state.activePromo = hit; return; }
      }
    } catch (_) {}
  }

  // Render the promo banner. Inline cssText defeats theme CSS overrides
  // (project memory: <style>-only color/background rules can be stripped by Shopify themes).
  function renderPromoBanner() {
    const banner = document.querySelector('[data-promo-banner]');
    if (!banner) return;
    const textEl = banner.querySelector('.wa-promo-banner__text');
    if (state.activePromo) {
      const p = state.activePromo;
      if (textEl) textEl.textContent = `${p.code} aktif — ekstra %${p.percent} indirim · ${p.label}`;
      banner.style.cssText = 'display:flex;align-items:center;gap:10px;padding:12px 16px;margin:0 auto 16px;max-width:1200px;border-radius:12px;background:linear-gradient(135deg,#22c55e 0%,#16a34a 100%);color:#ffffff;font-weight:600;font-size:0.875rem;box-shadow:0 2px 8px rgba(34,197,94,0.25);';
      banner.removeAttribute('hidden');
    } else {
      banner.setAttribute('hidden', '');
      banner.style.cssText = '';
    }
  }

  // ============================================
  // UI UPDATE
  // ============================================
  function updateUI() {
    const pricing = calculatePricing();
    const totalQty = getTotalQuantity();
    const tier = Math.min(totalQty, 5);
    const synergy = totalQty > 0 ? SYNERGY_CONFIG[tier] : { percent: 0, text: 'Başlayın' };
    const rec = getRecommendation();
    const ritual = getRitualGuide();
    const synExp = getSynergyExplanation();

    renderPromoBanner();

    // Tier celebration: detect tier boundary crossing
    if (state.previousTier >= 0 && tier > state.previousTier && tier >= 2) {
      celebrateTierUnlock(tier, synergy, pricing);
    }
    state.previousTier = tier;

    // Update product cards
    productCards.forEach(card => {
      const isAdded = state.items.find(i => i.id === card.dataset.productId);
      card.classList.toggle('wa-product-card--added', !!isAdded);
      const cardHandle = matchHandle(card.dataset.productTitle);
      card.classList.toggle('wa-product-card--recommended', rec && cardHandle === rec.handle && !isAdded);
    });

    // Update synergy map with selected product handles
    const selectedHandles = state.items.map(i => matchHandle(i.title));
    SynergyMapRenderer.update(selectedHandles);

    if (state.isMobile) {
      updateMobileUI(pricing, synergy, tier, rec, ritual, synExp);
    } else {
      updateDesktopUI(pricing, synergy, tier, rec, ritual, synExp);
    }
  }

  function updateMobileUI(pricing, synergy, tier, rec, ritual, synExp) {
    dock.classList.toggle('wa-dock--empty', state.items.length === 0);
    if (state.items.length === 0 && state.isExpanded) {
      state.isExpanded = false;
      dock.classList.remove('wa-dock--expanded');
      setBodyScroll(false); // Reset overflow when auto-closing empty slider
    }

    // Thumbnails
    const thumbs = dock.querySelector('.wa-dock__thumbnails');
    const emptyTxt = dock.querySelector('.wa-dock__empty-text');
    thumbs.innerHTML = state.items.map(i => `<img src="${i.image}" class="wa-dock__thumbnail">`).join('');
    emptyTxt.style.display = state.items.length ? 'none' : 'block';

    // Info
    const totalQty = getTotalQuantity();
