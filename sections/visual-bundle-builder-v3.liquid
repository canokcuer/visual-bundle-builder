        dockSavingsChip.textContent = formatMoney(pricing.discount) + ' kazandın';
        dockSavingsChip.style.cssText = `display:block;background:${tc.bg};color:${tc.text};font-size:0.7rem;font-weight:600;padding:5px 10px;border-radius:6px;text-align:center;border:1px solid ${tc.border};margin-bottom:6px;transition:color 0.3s,background 0.3s,border-color 0.3s;`;
      } else {
