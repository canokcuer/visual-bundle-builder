        mobileBadge.textContent = `%${Math.round(synergy.discount * 100)} indirim`;
        mobileBadge.style.cssText = 'display:inline-block;background:#22c55e;color:#fff;font-size:0.65rem;font-weight:700;padding:4px 8px;border-radius:100px;white-space:nowrap;flex-shrink:0;';
      } else {
        mobileBadge.style.display = 'none';
      }
