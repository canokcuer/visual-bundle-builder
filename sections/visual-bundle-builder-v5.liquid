  function formatPrice(priceInCents) {
    const lira = priceInCents / 100;
    return '₺' + lira.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function getSynergyScore(handleA, handleB) {
    const a = SYNERGY_MAP[handleA];
    if (a && a.synergies[handleB]) return a.synergies[handleB];
    const b = SYNERGY_MAP[handleB];
    if (b && b.synergies[handleA]) return b.synergies[handleA];
    return null;
  }

  function calculateOverallSynergy() {
    if (state.items.length < 2) return 0;
    let total = 0, count = 0;
    for (let i = 0; i < state.items.length; i++) {
      for (let j = i + 1; j < state.items.length; j++) {
        const syn = getSynergyScore(state.items[i].handle, state.items[j].handle);
        if (syn) { total += syn.score; count++; }
      }
    }
    return count > 0 ? Math.round(total / count) : 0;
  }

  function getCurrentTier() {
    let tier = DISCOUNT_TIERS[0];
    for (const t of DISCOUNT_TIERS) {
      if (state.items.length >= t.min) tier = t;
    }
    return tier;
  }

  function announce(message) {
    if (state.announceTimeout) clearTimeout(state.announceTimeout);
    state.announceTimeout = setTimeout(function() {
      if (DOM.liveRegion) {
        DOM.liveRegion.textContent = '';
        requestAnimationFrame(function() {
          DOM.liveRegion.textContent = message;
        });
      }
    }, 150);
  }

  /* ============================================
     CART API (with 1-retry on failure)
     ============================================ */

  async function addToShopifyCart(variantId) {
    for (let attempt = 0; attempt < 2; attempt++) {
      try {
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
        });
        if (res.ok) return true;
        if (attempt === 0) continue;
        showToast('Could not add to cart. Please try again.', 'error');
        return false;
      } catch (e) {
        if (attempt === 0) continue;
        console.error('Cart error:', e);
        showToast('Network error. Please check your connection.', 'error');
        return false;
      }
    }
    return false;
  }

  async function removeFromShopifyCart(variantId) {
    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId.toString(), quantity: 0 })
      });
    } catch (e) {
      console.error('Cart remove error:', e);
    }
  }

  /* ============================================
     TOAST NOTIFICATIONS
     ============================================ */

  function showToast(message, type) {
    if (state.toastTimeout) {
      clearTimeout(state.toastTimeout);
    }
    DOM.toast.innerHTML = '<div class="ab-toast__content">' +
      (type === 'error' ? '<span class="ab-toast__icon">⚠️</span>' : '') +
      '<span>' + message + '</span></div>';
    DOM.toast.classList.add('ab-toast--visible');
    state.toastTimeout = setTimeout(function() {
      DOM.toast.classList.remove('ab-toast--visible');
    }, 3000);
  }

  function showAchievement(key) {
    if (state.achievedMilestones.has(key)) return;
    state.achievedMilestones.add(key);
    var a = ACHIEVEMENTS[key];
    if (!a) return;
    showToast(a.icon + ' ' + a.title + ' — ' + a.subtitle);
    announce(a.title + '. ' + a.subtitle);
  }

  /* ============================================
