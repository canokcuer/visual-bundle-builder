        '</div>' +
        '<button class="ab-sidebar__item-remove" data-remove="' + item.handle + '" aria-label="Remove ' + item.title + '">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
            '<path d="M18 6L6 18M6 6l12 12"/>' +
          '</svg>' +
        '</button>' +
      '</div>';
    }).join('');
  }

  function updateDock() {
    var hasItems = state.items.length > 0;
    DOM.dock.classList.toggle('ab-dock--empty', !hasItems);
    DOM.dockCheckout.disabled = !hasItems;

    // Thumbnails
    if (hasItems) {
      DOM.dockEmptyText.style.display = 'none';
      DOM.dockThumbnails.innerHTML = state.items.map(function(item) {
        return '<img src="' + item.image + '" alt="' + item.title + '" class="ab-dock__thumbnail" width="32" height="32">';
      }).join('');
    } else {
      DOM.dockEmptyText.style.display = '';
      DOM.dockThumbnails.innerHTML = '';
    }

    DOM.dockCount.textContent = state.items.length + ' item' + (state.items.length !== 1 ? 's' : '');

    // Dock items list (expanded view)
    DOM.dockItems.innerHTML = state.items.map(function(item) {
      return '<div class="ab-dock__item" role="listitem">' +
        '<img src="' + item.image + '" alt="' + item.title + '" class="ab-dock__item-image" width="36" height="36">' +
        '<span class="ab-dock__item-title">' + item.title + '</span>' +
        '<span class="ab-dock__item-price">' + formatPrice(item.price) + '</span>' +
        '<button class="ab-dock__item-remove" data-remove="' + item.handle + '" aria-label="Remove ' + item.title + '">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
            '<path d="M18 6L6 18M6 6l12 12"/>' +
          '</svg>' +
        '</button>' +
      '</div>';
    }).join('');
  }

  function updatePricing() {
    var subtotal = state.items.reduce(function(sum, i) { return sum + i.price; }, 0);
    var tier = getCurrentTier();
    var discountAmount = Math.round(subtotal * tier.discount / 100);
    var total = subtotal - discountAmount;

    // Sidebar pricing
    DOM.sidebarSubtotal.textContent = formatPrice(subtotal);
    DOM.sidebarDiscount.textContent = '-' + formatPrice(discountAmount);
    DOM.sidebarDiscountRow.style.display = tier.discount > 0 ? 'flex' : 'none';
    DOM.sidebarTotal.textContent = formatPrice(total);

    // Dock pricing
    DOM.dockSubtotal.textContent = formatPrice(subtotal);
    DOM.dockDiscount.textContent = '-' + formatPrice(discountAmount);
    DOM.dockDiscountRow.style.display = tier.discount > 0 ? 'flex' : 'none';
    DOM.dockNetTotal.textContent = formatPrice(total);
    DOM.dockMiniTotal.textContent = formatPrice(total);
    DOM.dockFooterValue.textContent = formatPrice(total);
  }

  function updateTiers() {
    var tier = getCurrentTier();
    var count = state.items.length;
    var hasTier = count >= 2;

    DOM.sidebarTiers.style.display = hasTier ? 'block' : 'none';
    DOM.dockTiers.style.display = hasTier ? 'block' : 'none';

    DOM.sidebarTiersCurrent.textContent = tier.label;
    DOM.dockTiersCurrent.textContent = tier.label;
    DOM.dockTierBadge.textContent = tier.label;

    // Progress fill: 0 items=0%, 2=25%, 3=50%, 4=75%, 5=100%
    var pct = count <= 1 ? 0 : Math.min(((count - 1) / 4) * 100, 100);
    DOM.sidebarTiersFill.style.width = pct + '%';
    DOM.dockTiersFill.style.width = pct + '%';

    // Activate tier steps
    var steps = DOM.sidebarTiers.querySelectorAll('.ab-tier-step');
    steps.forEach(function(step) {
      var stepTier = parseInt(step.dataset.tier);
      step.classList.toggle('ab-tier-step--active', count >= stepTier);
    });
  }

  function updateSynergyRings() {
    var synergy = calculateOverallSynergy();

    // Sidebar ring (r=42, circumference = 2*PI*42 ≈ 264)
    var sidebarOffset = 264 - (264 * synergy / 100);
    DOM.sidebarRingProgress.style.strokeDashoffset = sidebarOffset;
    DOM.sidebarRingValue.textContent = synergy + '%';

    // Dock ring (r=32, circumference = 2*PI*32 ≈ 201)
    var dockOffset = 201 - (201 * synergy / 100);
    DOM.dockSynergyProgress.style.strokeDashoffset = dockOffset;
    DOM.dockSynergyValue.textContent = synergy + '%';
  }
  /* ============================================
     SYNERGY VISUALIZATION — "Golden Geometry"
     ============================================ */

  function updateSynergyViz() {
    if (state.items.length < 2) {
      DOM.sidebarSynergyViz.style.display = 'none';
      return;
    }
    DOM.sidebarSynergyViz.style.display = 'block';

    var items = state.items;
    var count = items.length;
    var cx = 150, cy = 110; // Center of the 300x220 SVG viewBox
    var radius = 70;

    // Calculate node positions in a regular polygon
    var positions = items.map(function(item, i) {
      var angle = (2 * Math.PI * i / count) - Math.PI / 2; // Start from top
      return {
        x: cx + radius * Math.cos(angle),
        y: cy + radius * Math.sin(angle),
        handle: item.handle,
        title: item.title,
        image: item.image,
        color: PRODUCT_COLORS[item.handle] || '#B8976A'
      };
    });

    // Render connections (quadratic bezier curves)
    var connectionsHTML = '';
    var scoresHTML = '';
    for (var i = 0; i < positions.length; i++) {
      for (var j = i + 1; j < positions.length; j++) {
        var a = positions[i], b = positions[j];
        var syn = getSynergyScore(a.handle, b.handle);
        if (!syn) continue;

        // Quadratic bezier with control point pulled toward center
        var midX = (a.x + b.x) / 2;
        var midY = (a.y + b.y) / 2;
        var dx = midX - cx, dy = midY - cy;
        var dist = Math.sqrt(dx * dx + dy * dy);
        var pullFactor = 0.3;
        var ctrlX = midX - dx * pullFactor;
        var ctrlY = midY - dy * pullFactor;

        var strokeWidth = 1.5 + (syn.score / 100) * 1.5;
        var gradId = 'ab-grad-' + i + '-' + j;

        connectionsHTML += '<defs><linearGradient id="' + gradId + '" x1="' + (a.x/300*100) + '%" y1="' + (a.y/220*100) + '%" x2="' + (b.x/300*100) + '%" y2="' + (b.y/220*100) + '%">' +
          '<stop offset="0%" stop-color="' + a.color + '" stop-opacity="0.6"/>' +
          '<stop offset="100%" stop-color="' + b.color + '" stop-opacity="0.6"/>' +
          '</linearGradient></defs>';

        connectionsHTML += '<path class="ab-synergy__connection" d="M' + a.x + ' ' + a.y + ' Q' + ctrlX + ' ' + ctrlY + ' ' + b.x + ' ' + b.y + '" stroke="url(#' + gradId + ')" stroke-width="' + strokeWidth + '" stroke-dasharray="' + getPathLength(a, b, ctrlX, ctrlY) + '" stroke-dashoffset="' + getPathLength(a, b, ctrlX, ctrlY) + '" style="animation: ab-draw-line 0.6s var(--ab-ease-organic) ' + (i * 0.1) + 's forwards"/>';

        // Score badge at curve midpoint
        var badgeX = (a.x + 2*ctrlX + b.x) / 4;
        var badgeY = (a.y + 2*ctrlY + b.y) / 4;
        scoresHTML += '<g transform="translate(' + badgeX + ',' + badgeY + ')">' +
          '<rect x="-16" y="-9" width="32" height="18" rx="9" fill="#B8976A" opacity="0.9"/>' +
          '<text class="ab-synergy__score-badge" text-anchor="middle" dy="4" fill="white">' + syn.score + '%</text>' +
          '</g>';
      }
    }

    // Render nodes (product images in circles)
    var nodeRadius = 22;
    var nodesHTML = '';
    positions.forEach(function(pos, idx) {
      var clipId = 'ab-clip-' + pos.handle;
      nodesHTML += '<g class="ab-synergy__node" tabindex="0" role="button" aria-label="' + pos.title + ' synergy node" data-handle="' + pos.handle + '" style="animation: ab-node-pop 0.4s var(--ab-ease-spring) ' + (idx * 0.1 + 0.2) + 's both">' +
        '<defs><clipPath id="' + clipId + '"><circle cx="' + pos.x + '" cy="' + pos.y + '" r="' + nodeRadius + '"/></clipPath></defs>' +
        '<circle cx="' + pos.x + '" cy="' + pos.y + '" r="' + (nodeRadius + 3) + '" fill="white" filter="url(#ab-node-shadow)"/>' +
        '<circle cx="' + pos.x + '" cy="' + pos.y + '" r="' + (nodeRadius + 2) + '" fill="none" stroke="' + pos.color + '" stroke-width="2"/>' +
        '<image href="' + pos.image + '" x="' + (pos.x - nodeRadius) + '" y="' + (pos.y - nodeRadius) + '" width="' + (nodeRadius*2) + '" height="' + (nodeRadius*2) + '" clip-path="url(#' + clipId + ')" preserveAspectRatio="xMidYMid slice"/>' +
        '</g>';
    });

    // Center element: overall synergy score
    var overallSynergy = calculateOverallSynergy();
    var centerHTML = '';
    if (overallSynergy > 0) {
      centerHTML = '<circle cx="' + cx + '" cy="' + cy + '" r="18" fill="#B8976A" opacity="0.15"/>' +
        '<circle cx="' + cx + '" cy="' + cy + '" r="14" fill="white" filter="url(#ab-node-shadow)"/>' +
        '<text class="ab-synergy__center-score" x="' + cx + '" y="' + cy + '" text-anchor="middle" dy="5">' + overallSynergy + '%</text>';
    }

    DOM.synergyConnections.innerHTML = connectionsHTML;
    DOM.synergyScores.innerHTML = scoresHTML;
    DOM.synergyNodes.innerHTML = nodesHTML;
    DOM.synergyCenter.innerHTML = centerHTML;
  }

  function getPathLength(a, b, cx, cy) {
    // Approximate quadratic bezier length
    var dx = b.x - a.x, dy = b.y - a.y;
    var straightLen = Math.sqrt(dx*dx + dy*dy);
    return Math.round(straightLen * 1.2);
  }

  /* ============================================
     MODAL — Open / Close / Tabs / Focus Trap
     ============================================ */

  var previouslyFocused = null;

  function openModal(handle) {
    var product = PRODUCT_DATA[handle];
    var synData = SYNERGY_MAP[handle];
    if (!product || !synData) return;

    previouslyFocused = document.activeElement;
    state.modalProduct = handle;

    // Populate header
    DOM.modalTitle.textContent = synData.name;
    var item = state.items.find(function(i) { return i.handle === handle; });
    var card = DOM.grid.querySelector('[data-product-handle="' + handle + '"]');

    DOM.modalImage.src = card ? card.dataset.productImage : '';
    DOM.modalImage.alt = synData.name;
    DOM.modalTiming.textContent = synData.timing;

    // Populate tabs
    populateModalTab('benefits', product.benefits.map(function(b) {
      return '<div class="ab-benefit"><div class="ab-benefit__icon">' + b.icon + '</div><div class="ab-benefit__text">' + b.text + '</div></div>';
    }).join(''));

    populateModalTab('ingredients', product.ingredients.map(function(ig) {
      return '<div class="ab-ingredient"><span class="ab-ingredient__name">' + ig.name + '</span><span class="ab-ingredient__amount">' + ig.amount + '</span></div>';
    }).join(''));

    populateModalTab('science', '<p class="ab-science-text">' + product.science + '</p>');

    // Synergies tab
    var synergiesHTML = '';
    var synergies = SYNERGY_MAP[handle].synergies;
    for (var partner in synergies) {
      if (synergies.hasOwnProperty(partner)) {
        var s = synergies[partner];
        var partnerName = SYNERGY_MAP[partner] ? SYNERGY_MAP[partner].name : partner;
        synergiesHTML += '<div class="ab-synergy-pair">' +
          '<span class="ab-synergy-pair__score">' + s.score + '%</span>' +
          '<div class="ab-synergy-pair__info">' +
            '<div class="ab-synergy-pair__name">+ ' + partnerName + '</div>' +
            '<div class="ab-synergy-pair__reason">' + s.reason + '</div>' +
          '</div>' +
        '</div>';
      }
    }
    populateModalTab('synergies', synergiesHTML || '<p class="ab-science-text">No synergy data available.</p>');

    // Update add button state
    var isSelected = state.items.some(function(i) { return i.handle === handle; });
    DOM.modalAddText.textContent = isSelected ? 'Added to Ritual' : 'Add to Ritual';
    DOM.modalAdd.classList.toggle('ab-modal__add--added', isSelected);

    // Reset to first tab
    switchModalTab('benefits');

    // Show modal
    DOM.modal.classList.add('ab-modal--open');
    DOM.modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // Focus the close button after transition
    setTimeout(function() {
      DOM.modalClose.focus();
    }, 300);
  }

  function populateModalTab(name, html) {
    var panel = DOM.modal.querySelector('#ab-tab-' + name);
    if (panel) panel.innerHTML = html;
  }

  function closeModal() {
    DOM.modal.classList.remove('ab-modal--open');
    DOM.modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    state.modalProduct = null;

    if (previouslyFocused) {
      previouslyFocused.focus();
      previouslyFocused = null;
    }
  }

  function switchModalTab(tabName) {
    DOM.modalTabs.forEach(function(tab) {
      var isActive = tab.dataset.tab === tabName;
      tab.classList.toggle('ab-modal__tab--active', isActive);
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    DOM.modalPanels.forEach(function(panel) {
      var isActive = panel.id === 'ab-tab-' + tabName;
      panel.hidden = !isActive;
    });

    // Move tab indicator
    var activeTab = DOM.modal.querySelector('.ab-modal__tab--active');
    if (activeTab && DOM.modalTabIndicator) {
      DOM.modalTabIndicator.style.left = activeTab.offsetLeft + 'px';
      DOM.modalTabIndicator.style.width = activeTab.offsetWidth + 'px';
    }
  }

  // Focus trap for modal
  function trapFocus(e) {
    if (!DOM.modal.classList.contains('ab-modal--open')) return;
    var focusable = DOM.modalPanel.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (focusable.length === 0) return;
    var first = focusable[0];
    var last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  /* ============================================
     DOCK EXPAND / COLLAPSE
     ============================================ */

  function expandDock() {
    state.isDockExpanded = true;
    DOM.dock.classList.add('ab-dock--open');
    DOM.dockExpand.setAttribute('aria-expanded', 'true');
    DOM.dockExpanded.setAttribute('aria-hidden', 'false');
    DOM.dockClose.focus();
  }

  function collapseDock() {
    state.isDockExpanded = false;
    DOM.dock.classList.remove('ab-dock--open');
    DOM.dockExpand.setAttribute('aria-expanded', 'false');
    DOM.dockExpanded.setAttribute('aria-hidden', 'true');
    DOM.dockExpand.focus();
  }

  /* ============================================
     CHECKOUT
     ============================================ */

  function handleCheckout() {
    if (state.items.length === 0) return;
    window.location.href = '/cart';
  }

  /* ============================================
     EVENT HANDLERS — Event delegation
     ============================================ */

  // Grid: card clicks and explore buttons
  DOM.grid.addEventListener('click', function(e) {
    var exploreBtn = e.target.closest('[data-explore]');
    if (exploreBtn) {
      e.stopPropagation();
      var card = exploreBtn.closest('.ab-card');
      if (card) openModal(card.dataset.productHandle);
      return;
    }

    var card = e.target.closest('.ab-card');
    if (card && !e.target.closest('.ab-card__explore')) {
      addProduct(card);
    }
  });

  // Grid: keyboard support for cards
  DOM.grid.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      var card = e.target.closest('.ab-card');
      if (card && e.target === card) {
        e.preventDefault();
        addProduct(card);
      }
    }
  });

  // Sidebar: remove buttons (event delegation)
  DOM.sidebarItems.addEventListener('click', function(e) {
    var removeBtn = e.target.closest('[data-remove]');
    if (removeBtn) {
      removeProduct(removeBtn.dataset.remove);
    }
  });

  // Sidebar: checkout
  DOM.sidebarCheckout.addEventListener('click', handleCheckout);

  // Dock: expand/collapse
  DOM.dockExpand.addEventListener('click', expandDock);
  DOM.dockClose.addEventListener('click', collapseDock);

  // Dock: remove buttons (event delegation)
  DOM.dockItems.addEventListener('click', function(e) {
    var removeBtn = e.target.closest('[data-remove]');
    if (removeBtn) {
      removeProduct(removeBtn.dataset.remove);
    }
  });

  // Dock: checkout
  DOM.dockCheckout.addEventListener('click', handleCheckout);

  // Dock: handle swipe gesture
  var touchStartY = 0;
  DOM.dock.addEventListener('touchstart', function(e) {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  DOM.dock.addEventListener('touchend', function(e) {
    var touchEndY = e.changedTouches[0].clientY;
    var diff = touchStartY - touchEndY;
    if (diff > 50 && !state.isDockExpanded) {
      expandDock();
    } else if (diff < -50 && state.isDockExpanded) {
      collapseDock();
    }
  }, { passive: true });

  // Modal: backdrop click
  DOM.modalBackdrop.addEventListener('click', closeModal);
  DOM.modalBack.addEventListener('click', closeModal);
  DOM.modalClose.addEventListener('click', closeModal);

  // Modal: tabs
  DOM.modalTabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      switchModalTab(tab.dataset.tab);
    });
  });

  // Modal: tab keyboard navigation (arrow keys)
  DOM.modal.querySelector('.ab-modal__tabs').addEventListener('keydown', function(e) {
    var tabs = Array.from(DOM.modalTabs);
    var current = tabs.findIndex(function(t) { return t.classList.contains('ab-modal__tab--active'); });

    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
      e.preventDefault();
      var next;
      if (e.key === 'ArrowRight') {
        next = (current + 1) % tabs.length;
      } else {
        next = (current - 1 + tabs.length) % tabs.length;
      }
      switchModalTab(tabs[next].dataset.tab);
      tabs[next].focus();
    }
  });

  // Modal: add button
  DOM.modalAdd.addEventListener('click', function() {
    if (!state.modalProduct) return;
    var card = DOM.grid.querySelector('[data-product-handle="' + state.modalProduct + '"]');
    if (card) {
      addProduct(card);
      // Update button state
      var isNowSelected = state.items.some(function(i) { return i.handle === state.modalProduct; });
      DOM.modalAddText.textContent = isNowSelected ? 'Added to Ritual' : 'Add to Ritual';
      DOM.modalAdd.classList.toggle('ab-modal__add--added', isNowSelected);
    }
  });

  // Global: Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (DOM.modal.classList.contains('ab-modal--open')) {
        closeModal();
      } else if (state.isDockExpanded) {
        collapseDock();
      }
    }
    // Focus trap
    if (e.key === 'Tab' && DOM.modal.classList.contains('ab-modal--open')) {
      trapFocus(e);
    }
  });

  // Synergy viz: keyboard navigation for nodes
  DOM.sidebarSynergyViz.addEventListener('keydown', function(e) {
    var node = e.target.closest('.ab-synergy__node');
    if (!node) return;

    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      var handle = node.getAttribute('data-handle');
      if (handle) openModal(handle);
    }

    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
      e.preventDefault();
      var nodes = Array.from(DOM.synergyNodes.querySelectorAll('.ab-synergy__node'));
      var idx = nodes.indexOf(node);
      var next;
      if (e.key === 'ArrowRight') {
        next = (idx + 1) % nodes.length;
      } else {
        next = (idx - 1 + nodes.length) % nodes.length;
      }
      nodes[next].focus();
    }
  });

  /* ============================================
     RESIZE OBSERVER — Responsive behavior
     ============================================ */

  if (typeof ResizeObserver !== 'undefined') {
    var resizeObserver = new ResizeObserver(function(entries) {
      var width = entries[0].contentRect.width;
      var wasMobile = state.isMobile;
      state.isMobile = width < 1024;

      if (wasMobile !== state.isMobile && state.isDockExpanded) {
        collapseDock();
      }
    });
    resizeObserver.observe(DOM.section);
  }

  /* ============================================
     INITIALIZATION
     ============================================ */

  // Staggered reveal via IntersectionObserver
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('ab-atelier--visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  observer.observe(DOM.section);

  // Add line draw keyframe dynamically (for synergy connections)
  var styleSheet = document.createElement('style');
  styleSheet.textContent = '@keyframes ab-draw-line { to { stroke-dashoffset: 0; } } @keyframes ab-node-pop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }';
  document.head.appendChild(styleSheet);

})();
</script>

