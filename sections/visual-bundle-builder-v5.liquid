    state.isAwakened = true;
    DOM.section.classList.remove('ab-atelier--dormant');
    DOM.section.classList.add('ab-atelier--awakened');
  }

  function dormantSection() {
    if (!state.isAwakened) return;
    state.isAwakened = false;
    DOM.section.classList.remove('ab-atelier--awakened');
    DOM.section.classList.add('ab-atelier--dormant');
  }

  /* ============================================
     ADD / REMOVE PRODUCT
     ============================================ */

  async function addProduct(card) {
    const handle = card.dataset.productHandle;
    if (state.items.find(function(i) { return i.handle === handle; })) {
      removeProduct(handle);
      return;
    }

    // Loading state
    card.classList.add('ab-card--loading');

    const productData = {
      id: card.dataset.productId,
      handle: handle,
      title: card.dataset.productTitle,
      price: parseInt(card.dataset.productPrice),
      image: card.dataset.productImage,
      variantId: card.dataset.variantId,
      url: card.dataset.productUrl,
      quantity: 1
    };

    // Add to Shopify cart
    const success = await addToShopifyCart(productData.variantId);
    card.classList.remove('ab-card--loading');

    if (!success) return;

    // Add to state
    state.items.push(productData);
    card.classList.add('ab-card--selected');
    card.setAttribute('aria-pressed', 'true');
    card.setAttribute('aria-label', 'Remove ' + productData.title + ' from your ritual');

    // Update action button text
    var actionText = card.querySelector('.ab-card__action-text');
    if (actionText) actionText.textContent = 'Added';

    // Awaken on first add
    if (state.items.length === 1) {
      awakenSection();
      showAchievement('firstItem');
    }
    if (state.items.length === 2) showAchievement('twoItems');
    if (state.items.length === 3) showAchievement('threeItems');
    if (state.items.length === 4) showAchievement('fourItems');
    if (state.items.length === 5) showAchievement('fiveItems');

    var synergy = calculateOverallSynergy();
    if (synergy >= 90) showAchievement('highSynergy');

    announce(productData.title + ' added to ritual. ' + state.items.length + ' products selected.');
    updateUI();
  }

  function removeProduct(handle) {
    var idx = state.items.findIndex(function(i) { return i.handle === handle; });
    if (idx === -1) return;
    var item = state.items[idx];

    removeFromShopifyCart(item.variantId);
    state.items.splice(idx, 1);

    // Reset card state
    var card = DOM.grid.querySelector('[data-product-handle="' + handle + '"]');
    if (card) {
      card.classList.remove('ab-card--selected');
      card.setAttribute('aria-pressed', 'false');
      card.setAttribute('aria-label', 'Add ' + item.title + ' to your ritual');
      var actionText = card.querySelector('.ab-card__action-text');
      if (actionText) actionText.textContent = 'Add to Ritual';
    }

    if (state.items.length === 0) {
      dormantSection();
    }

    announce(item.title + ' removed from ritual. ' + state.items.length + ' products remaining.');
    updateUI();
  }

