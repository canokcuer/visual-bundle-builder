{% comment %}
  ============================================
  CYRASOUL - Visual Bundle Builder v5
  "The Atelier"

  Aesthetic: Minimalist Luxury + Organic Warmth
  - Warm stone palette with cream backgrounds
  - Editorial magazine-style product cards
  - Golden geometry synergy visualization
  - Staggered reveal animations

  Typography: Playfair Display + Inter + JetBrains Mono
  ============================================
{% endcomment %}

<!-- Skip Link for Accessibility -->
<a href="#ab-products" class="ab-skip-link">Skip to products</a>

<section
  id="the-atelier"
  class="ab-atelier ab-atelier--dormant"
  data-section-id="{{ section.id }}"
>
  <!-- Ambient Orbs (replaces v4 particle system) -->
  <div class="ab-ambient" aria-hidden="true">
    <div class="ab-ambient__orb ab-ambient__orb--1"></div>
    <div class="ab-ambient__orb ab-ambient__orb--2"></div>
    <div class="ab-ambient__orb ab-ambient__orb--3"></div>
  </div>

  <!-- Screen Reader Announcements -->
  <div class="ab-visually-hidden" aria-live="polite" aria-atomic="true" id="ab-sr-announcements"></div>

  <!-- Header -->
  <header class="ab-header">
    <span class="ab-header__eyebrow">{{ section.settings.eyebrow_text }}</span>
    <h2 class="ab-header__title">{{ section.settings.title }}</h2>
    <p class="ab-header__subtitle">{{ section.settings.subtitle }}</p>
  </header>

  <div class="ab-layout">
    <!-- Product Grid -->
    <div id="ab-products" class="ab-grid" role="region" aria-label="Available products">
      {% assign collection = collections[section.settings.collection] %}
      {% for product in collection.products limit: section.settings.product_limit %}
        <article
          class="ab-card"
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          data-product-title="{{ product.title }}"
          data-product-price="{{ product.price }}"
          data-product-image="{{ product.featured_image | image_url: width: 600 }}"
          data-variant-id="{{ product.first_available_variant.id }}"
          data-product-url="{{ product.url }}"
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-label="Add {{ product.title }} to your ritual"
          style="--card-index: {{ forloop.index0 }}; --card-color: {% if product.handle == 'mindfuel' %}#3B82F6{% elsif product.handle == 'reset-button' %}#10B981{% elsif product.handle == 'dreamglow' %}#8B5CF6{% elsif product.handle == 'dailyglow' %}#F59E0B{% elsif product.handle == 'thechill' %}#06B6D4{% else %}#B8976A{% endif %}"
        >
          <!-- Product Color Accent Bar -->
          <div class="ab-card__accent" aria-hidden="true"></div>

          <div class="ab-card__image-wrap">
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.title }}"
              class="ab-card__image"
              loading="lazy"
              width="600"
              height="600"
            >
            <div class="ab-card__vignette" aria-hidden="true"></div>
          </div>

          <div class="ab-card__body">
            <div class="ab-card__meta">
              <h3 class="ab-card__title">{{ product.title }}</h3>
              <span class="ab-card__price" data-price="{{ product.price }}">
                {{ product.price | money_without_trailing_zeros }}
              </span>
            </div>

            <p class="ab-card__description">
              {% if product.handle == 'dreamglow' %}Deep restoration for cellular renewal
              {% elsif product.handle == 'dailyglow' %}Radiance from within, day after day
              {% elsif product.handle == 'mindfuel' %}Clarity and focus without the crash
              {% elsif product.handle == 'thechill' %}Calm the noise, embrace serenity
              {% elsif product.handle == 'reset-button' %}Full system reset and recovery
              {% else %}Elevate your wellness ritual
              {% endif %}
            </p>

            <!-- Ingredient Pills -->
            <div class="ab-card__ingredients">
              {% for tag in product.tags limit: 3 %}
                {% if tag contains 'ingredient:' %}
                  <span class="ab-pill">{{ tag | remove: 'ingredient:' }}</span>
                {% endif %}
              {% endfor %}
            </div>

            <button class="ab-card__action" aria-label="Add {{ product.title }}">
              <span class="ab-card__action-text">Add to Ritual</span>
              <span class="ab-card__action-loading" aria-hidden="true">
                <svg class="ab-spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-dasharray="31.4 31.4" stroke-linecap="round"/>
                </svg>
              </span>
              <svg class="ab-card__action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              <svg class="ab-card__action-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
          </div>

          <!-- Explore Button (always visible on touch) -->
          <button class="ab-card__explore" data-explore aria-label="Explore {{ product.title }} details">
            <span>Explore</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
        </article>
      {% endfor %}
    </div>

    <!-- Desktop Sidebar -->
    <aside class="ab-sidebar" aria-label="Your ritual summary">
      <div class="ab-sidebar__header">
        <h3 class="ab-sidebar__title">Your Ritual</h3>
        <div class="ab-sidebar__synergy-ring">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ab-sidebar__ring-track" cx="50" cy="50" r="42" fill="none" stroke-width="4"/>
            <circle class="ab-sidebar__ring-progress" cx="50" cy="50" r="42" fill="none" stroke-width="4"/>
          </svg>
          <span class="ab-sidebar__ring-value">0%</span>
        </div>
      </div>

      <!-- Empty State -->
      <div class="ab-sidebar__empty">
        <div class="ab-sidebar__empty-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="32" cy="32" r="24" stroke-dasharray="6 4" opacity="0.4"/>
            <circle cx="32" cy="20" r="3" fill="currentColor" stroke="none" opacity="0.3"/>
            <circle cx="20" cy="38" r="3" fill="currentColor" stroke="none" opacity="0.3"/>
            <circle cx="44" cy="38" r="3" fill="currentColor" stroke="none" opacity="0.3"/>
            <line x1="32" y1="20" x2="20" y2="38" stroke-dasharray="3 3" opacity="0.2"/>
            <line x1="32" y1="20" x2="44" y2="38" stroke-dasharray="3 3" opacity="0.2"/>
            <line x1="20" y1="38" x2="44" y2="38" stroke-dasharray="3 3" opacity="0.2"/>
          </svg>
        </div>
        <p class="ab-sidebar__empty-text">Select products to build<br>your wellness ritual</p>
      </div>

      <!-- Synergy Visualization ("The Octagon" / Golden Geometry) -->
      <div class="ab-sidebar__synergy-viz" style="display: none;">
        <svg class="ab-synergy-svg" viewBox="0 0 300 220" role="img" aria-label="Synergy visualization showing connections between selected products">
          <title>Product Synergy Map</title>
          <desc>Visual representation of how your selected products work together</desc>
          <defs>
            <filter id="ab-node-shadow" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="rgba(0,0,0,0.15)"/>
            </filter>
          </defs>
          <g class="ab-synergy__connections"></g>
          <g class="ab-synergy__scores"></g>
          <g class="ab-synergy__nodes"></g>
          <g class="ab-synergy__center"></g>
        </svg>
      </div>

      <!-- Selected Items List -->
      <div class="ab-sidebar__items" role="list" aria-label="Selected products"></div>

      <!-- Tier Progress -->
      <div class="ab-sidebar__tiers" style="display: none;">
        <div class="ab-sidebar__tiers-header">
          <span class="ab-sidebar__tiers-label">Ritual Tier</span>
          <span class="ab-sidebar__tiers-current">Start</span>
        </div>
        <div class="ab-sidebar__tiers-track">
          <div class="ab-sidebar__tiers-fill"></div>
          <div class="ab-sidebar__tiers-steps">
            <span class="ab-tier-step" data-tier="1"></span>
            <span class="ab-tier-step" data-tier="2">15%</span>
            <span class="ab-tier-step" data-tier="3">20%</span>
            <span class="ab-tier-step" data-tier="4">25%</span>
            <span class="ab-tier-step" data-tier="5">30%</span>
          </div>
        </div>
      </div>

      <!-- Pricing -->
      <div class="ab-sidebar__pricing" aria-live="polite" aria-atomic="true">
        <div class="ab-sidebar__price-row">
          <span>Subtotal</span>
          <span class="ab-sidebar__subtotal">&#8378;0</span>
        </div>
        <div class="ab-sidebar__price-row ab-sidebar__price-row--discount" style="display: none;">
          <span>Ritual Discount</span>
          <span class="ab-sidebar__discount">-&#8378;0</span>
        </div>
        <div class="ab-sidebar__price-row ab-sidebar__price-row--total">
          <span>Total</span>
          <span class="ab-sidebar__total">&#8378;0</span>
        </div>
      </div>

      <!-- Checkout Button -->
      <button class="ab-sidebar__checkout" disabled aria-label="Complete your ritual and proceed to checkout">
        <span class="ab-sidebar__checkout-text">Complete Ritual</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </aside>
  </div>

  <!-- Mobile Dock -->
  <div class="ab-dock ab-dock--empty" role="complementary" aria-label="Ritual summary dock">
    <div class="ab-dock__handle" aria-hidden="true"><span></span></div>

    <!-- Collapsed View -->
    <div class="ab-dock__collapsed">
      <div class="ab-dock__preview">
        <span class="ab-dock__empty-text">Begin Your Ritual</span>
        <div class="ab-dock__thumbnails" aria-hidden="true"></div>
      </div>
      <div class="ab-dock__info">
        <span class="ab-dock__count" aria-live="polite">0 items</span>
        <span class="ab-dock__tier-badge">Start</span>
      </div>
      <div class="ab-dock__mini-total" aria-live="polite">&#8378;0</div>
      <button class="ab-dock__expand" aria-label="Expand ritual panel" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="18 15 12 9 6 15"/>
        </svg>
      </button>
    </div>

    <!-- Expanded View -->
    <div class="ab-dock__expanded" aria-hidden="true">
      <div class="ab-dock__expanded-header">
        <h3>Your Ritual</h3>
        <button class="ab-dock__close" aria-label="Close ritual panel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Dock Synergy Score -->
      <div class="ab-dock__synergy">
        <div class="ab-dock__synergy-circle">
          <svg viewBox="0 0 80 80" aria-hidden="true">
            <circle class="ab-dock__ring-track" cx="40" cy="40" r="32" fill="none" stroke-width="3.5"/>
            <circle class="ab-dock__ring-progress" cx="40" cy="40" r="32" fill="none" stroke-width="3.5"/>
          </svg>
          <span class="ab-dock__synergy-value">0%</span>
        </div>
        <span class="ab-dock__synergy-label">Synergy Score</span>
      </div>

      <!-- Dock Items List -->
      <div class="ab-dock__items" role="list" aria-label="Selected products"></div>

      <!-- Dock Tier Progress -->
      <div class="ab-dock__tiers" style="display: none;">
        <div class="ab-dock__tiers-header">
          <span>Discount Tier</span>
          <span class="ab-dock__tiers-current">Start</span>
        </div>
        <div class="ab-dock__tiers-track">
          <div class="ab-dock__tiers-fill"></div>
        </div>
      </div>

      <!-- Dock Pricing -->
      <div class="ab-dock__pricing" aria-live="polite" aria-atomic="true">
        <div class="ab-dock__price-row">
          <span>Subtotal</span>
          <span class="ab-dock__subtotal">&#8378;0</span>
        </div>
        <div class="ab-dock__price-row ab-dock__price-row--discount" style="display: none;">
          <span>Discount</span>
          <span class="ab-dock__discount">-&#8378;0</span>
        </div>
        <div class="ab-dock__price-row ab-dock__price-row--total">
          <span>Total</span>
          <span class="ab-dock__net-total">&#8378;0</span>
        </div>
      </div>
    </div>

    <!-- Sticky Checkout Footer in Dock -->
    <div class="ab-dock__footer">
      <div class="ab-dock__footer-total" aria-live="polite" aria-atomic="true">
        <span class="ab-dock__footer-label">Total</span>
        <span class="ab-dock__footer-value">&#8378;0</span>
      </div>
      <button class="ab-dock__checkout" disabled aria-label="Complete your ritual and proceed to checkout">
        <span>Complete Ritual</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Product Detail Modal -->
  <div class="ab-modal" id="ab-product-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Product details">
    <div class="ab-modal__backdrop"></div>
    <div class="ab-modal__panel">
      <header class="ab-modal__header">
        <button class="ab-modal__back" aria-label="Go back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <h3 class="ab-modal__title"></h3>
        <button class="ab-modal__close" aria-label="Close product details">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </header>

      <div class="ab-modal__scroll">
        <div class="ab-modal__hero">
          <img class="ab-modal__image" src="" alt="" width="400" height="400">
          <div class="ab-modal__timing"></div>
        </div>

        <nav class="ab-modal__tabs" role="tablist" aria-label="Product information">
          <button class="ab-modal__tab ab-modal__tab--active" data-tab="benefits" role="tab" aria-selected="true" aria-controls="ab-tab-benefits" id="ab-tab-btn-benefits">Benefits</button>
          <button class="ab-modal__tab" data-tab="ingredients" role="tab" aria-selected="false" aria-controls="ab-tab-ingredients" id="ab-tab-btn-ingredients">Ingredients</button>
          <button class="ab-modal__tab" data-tab="science" role="tab" aria-selected="false" aria-controls="ab-tab-science" id="ab-tab-btn-science">Science</button>
          <button class="ab-modal__tab" data-tab="synergies" role="tab" aria-selected="false" aria-controls="ab-tab-synergies" id="ab-tab-btn-synergies">Synergies</button>
          <div class="ab-modal__tab-indicator" aria-hidden="true"></div>
        </nav>

        <div class="ab-modal__body">
          <div class="ab-modal__tab-panel" id="ab-tab-benefits" role="tabpanel" aria-labelledby="ab-tab-btn-benefits"></div>
          <div class="ab-modal__tab-panel" id="ab-tab-ingredients" role="tabpanel" aria-labelledby="ab-tab-btn-ingredients" hidden></div>
          <div class="ab-modal__tab-panel" id="ab-tab-science" role="tabpanel" aria-labelledby="ab-tab-btn-science" hidden></div>
          <div class="ab-modal__tab-panel" id="ab-tab-synergies" role="tabpanel" aria-labelledby="ab-tab-btn-synergies" hidden></div>
        </div>
      </div>

      <footer class="ab-modal__footer">
        <button class="ab-modal__add">
          <span class="ab-modal__add-text">Add to Ritual</span>
        </button>
        <div class="ab-modal__qty" style="display: none;">
          <button class="ab-modal__qty-btn ab-modal__qty-minus" aria-label="Decrease quantity">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
          <span class="ab-modal__qty-value" aria-label="Quantity">1</span>
          <button class="ab-modal__qty-btn ab-modal__qty-plus" aria-label="Increase quantity">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
        </div>
      </footer>
    </div>
  </div>

  <!-- Achievement Toast -->
  <div class="ab-toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- SR-only live region for announcements -->
  <div id="ab-live-region" aria-live="polite" aria-atomic="true" class="ab-visually-hidden"></div>
</section>
<style>
  /* ============================================
     THE ATELIER — DESIGN TOKENS
     Namespace: --ab-*
     ============================================ */

  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    /* ─── Warm Stone Scale ─── */
    --ab-stone-50: #FAF7F2;
    --ab-stone-100: #F5F0E8;
    --ab-stone-200: #E8E0D4;
    --ab-stone-300: #D4C9B9;
    --ab-stone-400: #B8A99A;
    --ab-stone-500: #9C8E7E;
    --ab-stone-600: #7A6E62;
    --ab-stone-700: #5C524A;
    --ab-stone-800: #3D3632;
    --ab-stone-900: #1C1917;

    /* ─── Accent Colors ─── */
    --ab-cream: #FAF7F2;
    --ab-parchment: #F0EBE1;
    --ab-amber: #C8956C;
    --ab-amber-light: rgba(200, 149, 108, 0.15);
    --ab-amber-glow: rgba(200, 149, 108, 0.25);
    --ab-sage: #7D8B6F;
    --ab-sage-light: rgba(125, 139, 111, 0.15);
    --ab-gold: #B8976A;
    --ab-gold-light: rgba(184, 151, 106, 0.12);

    /* ─── Product Colors ─── */
    --ab-color-mindfuel: #3B82F6;
    --ab-color-reset: #10B981;
    --ab-color-dreamglow: #8B5CF6;
    --ab-color-dailyglow: #F59E0B;
    --ab-color-thechill: #06B6D4;

    /* ─── Feedback ─── */
    --ab-success: #7D8B6F;
    --ab-error: #C07070;

    /* ─── Typography ─── */
    --ab-font-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --ab-font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --ab-font-mono: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;

    /* ─── Spacing (4px base grid) ─── */
    --ab-space-1: 0.25rem;
    --ab-space-2: 0.5rem;
    --ab-space-3: 0.75rem;
    --ab-space-4: 1rem;
    --ab-space-5: 1.25rem;
    --ab-space-6: 1.5rem;
    --ab-space-8: 2rem;
    --ab-space-10: 2.5rem;
    --ab-space-12: 3rem;
    --ab-space-14: 3.5rem;
    --ab-space-16: 4rem;
    --ab-space-20: 5rem;

    /* ─── Border Radius ─── */
    --ab-radius-xs: 4px;
    --ab-radius-sm: 6px;
    --ab-radius-md: 10px;
    --ab-radius-lg: 16px;
    --ab-radius-xl: 24px;
    --ab-radius-pill: 100px;
    --ab-radius-circle: 50%;

    /* ─── Warm Shadows (5 levels) ─── */
    --ab-shadow-1: 0 1px 3px rgba(28, 25, 23, 0.04), 0 1px 2px rgba(28, 25, 23, 0.03);
    --ab-shadow-2: 0 3px 8px rgba(28, 25, 23, 0.06), 0 1px 3px rgba(28, 25, 23, 0.04);
    --ab-shadow-3: 0 6px 16px rgba(28, 25, 23, 0.08), 0 2px 6px rgba(28, 25, 23, 0.04);
    --ab-shadow-4: 0 12px 32px rgba(28, 25, 23, 0.1), 0 4px 12px rgba(28, 25, 23, 0.05);
    --ab-shadow-5: 0 20px 48px rgba(28, 25, 23, 0.14), 0 8px 20px rgba(28, 25, 23, 0.06);

    /* ─── Motion ─── */
    --ab-ease-out: cubic-bezier(0.33, 1, 0.68, 1);
    --ab-ease-in: cubic-bezier(0.32, 0, 0.67, 0);
    --ab-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --ab-ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ab-ease-organic: cubic-bezier(0.16, 1, 0.3, 1);
    --ab-ease-bounce: cubic-bezier(0.175, 0.885, 0.32, 1.275);

    /* ─── Durations ─── */
    --ab-duration-instant: 80ms;
    --ab-duration-fast: 150ms;
    --ab-duration-normal: 300ms;
    --ab-duration-slow: 500ms;
    --ab-duration-reveal: 800ms;
    --ab-duration-dramatic: 1000ms;

    /* ─── Z-Index Scale ─── */
    --ab-z-base: 0;
    --ab-z-card: 10;
    --ab-z-card-hover: 15;
    --ab-z-sticky: 50;
    --ab-z-dock: 100;
    --ab-z-modal-backdrop: 150;
    --ab-z-modal: 200;
    --ab-z-toast: 250;
    --ab-z-skip-link: 300;

    /* ─── Layout ─── */
    --ab-sidebar-width: 380px;
    --ab-dock-collapsed: 76px;
    --ab-max-width: 1400px;
    --ab-touch-min: 44px;
  }

  /* ============================================
     VISUALLY HIDDEN UTILITY
     ============================================ */

  .ab-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* ============================================
     SKIP LINK
     ============================================ */

  .ab-skip-link {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--ab-z-skip-link);
    padding: var(--ab-space-3) var(--ab-space-6);
    background: var(--ab-stone-900);
    color: var(--ab-stone-100);
    border-radius: var(--ab-radius-pill);
    font-family: var(--ab-font-body);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: top var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-skip-link:focus {
    top: var(--ab-space-4);
    outline: 2px solid var(--ab-amber);
    outline-offset: 3px;
  }

  /* ============================================
     BASE STYLES
     ============================================ */

  .ab-atelier {
    position: relative;
    min-height: 100vh;
    padding: var(--ab-space-14) var(--ab-space-6) var(--ab-space-8);
    background: var(--ab-cream);
    font-family: var(--ab-font-body);
    color: var(--ab-stone-800);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    transition: background var(--ab-duration-reveal) var(--ab-ease-organic);
  }

  .ab-atelier *,
  .ab-atelier *::before,
  .ab-atelier *::after {
    box-sizing: border-box;
  }

  /* ─── Dormant State ─── */
  .ab-atelier--dormant {
    background: var(--ab-cream);
  }

  .ab-atelier--dormant .ab-card {
    filter: saturate(0.9);
    transition: filter var(--ab-duration-slow) var(--ab-ease-organic);
  }

  .ab-atelier--dormant .ab-ambient__orb {
    opacity: 0;
  }

  /* ─── Awakened State ─── */
  .ab-atelier--awakened {
    background: linear-gradient(180deg, var(--ab-cream) 0%, var(--ab-parchment) 60%, var(--ab-cream) 100%);
  }

  .ab-atelier--awakened .ab-card {
    filter: saturate(1);
  }

  .ab-atelier--awakened .ab-ambient__orb {
    opacity: 0.4;
    transition: opacity var(--ab-duration-dramatic) var(--ab-ease-organic);
  }

  /* ============================================
     AMBIENT ORBS
     ============================================ */

  .ab-ambient {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: var(--ab-z-base);
    overflow: hidden;
  }

  .ab-ambient__orb {
    position: absolute;
    border-radius: var(--ab-radius-circle);
    filter: blur(80px);
    opacity: 0;
    will-change: opacity;
    transition: opacity var(--ab-duration-dramatic) var(--ab-ease-organic);
  }

  .ab-ambient__orb--1 {
    top: 10%;
    left: 15%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, var(--ab-amber-light) 0%, transparent 70%);
  }

  .ab-ambient__orb--2 {
    top: 50%;
    right: 10%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, var(--ab-sage-light) 0%, transparent 70%);
  }

  .ab-ambient__orb--3 {
    bottom: 15%;
    left: 40%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, var(--ab-gold-light) 0%, transparent 70%);
  }

  /* ============================================
     HEADER
     ============================================ */

  .ab-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--ab-space-14);
    padding: 0 var(--ab-space-4);
  }

  .ab-header__eyebrow {
    display: block;
    font-family: var(--ab-font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ab-amber);
    margin-bottom: var(--ab-space-4);
    opacity: 0;
    transform: translateY(10px);
  }

  .ab-atelier--visible .ab-header__eyebrow {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--ab-duration-slow) var(--ab-ease-out),
                transform var(--ab-duration-slow) var(--ab-ease-out);
  }

  .ab-header__title {
    font-family: var(--ab-font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
    color: var(--ab-stone-900);
    line-height: 1.15;
    margin: 0 0 var(--ab-space-4);
    letter-spacing: -0.01em;
    opacity: 0;
    transform: translateY(10px);
  }

  .ab-atelier--visible .ab-header__title {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--ab-duration-slow) var(--ab-ease-out) 100ms,
                transform var(--ab-duration-slow) var(--ab-ease-out) 100ms;
  }

  .ab-header__subtitle {
    font-family: var(--ab-font-body);
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    font-weight: 300;
    color: var(--ab-stone-500);
    line-height: 1.65;
    margin: 0;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    transform: translateY(10px);
  }

  .ab-atelier--visible .ab-header__subtitle {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--ab-duration-slow) var(--ab-ease-out) 200ms,
                transform var(--ab-duration-slow) var(--ab-ease-out) 200ms;
  }

  /* ============================================
     LAYOUT CONTAINER
     ============================================ */

  .ab-layout {
    display: flex;
    gap: var(--ab-space-10);
    max-width: var(--ab-max-width);
    margin: 0 auto;
    align-items: flex-start;
  }

  .ab-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--ab-space-6);
  }

  /* ============================================
     PRODUCT CARDS — Editorial Magazine Style
     ============================================ */

  .ab-card {
    position: relative;
    background: var(--ab-stone-50);
    border-radius: var(--ab-radius-lg);
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    box-shadow: var(--ab-shadow-2);
    transition: transform var(--ab-duration-normal) var(--ab-ease-out),
                box-shadow var(--ab-duration-normal) var(--ab-ease-out),
                border-color var(--ab-duration-normal) var(--ab-ease-out);
    z-index: var(--ab-z-card);
    opacity: 0;
    transform: translateY(20px);
    outline: none;
  }

  .ab-atelier--visible .ab-card {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--ab-duration-slow) var(--ab-ease-out) calc(300ms + var(--card-index) * 100ms),
                transform var(--ab-duration-slow) var(--ab-ease-out) calc(300ms + var(--card-index) * 100ms),
                box-shadow var(--ab-duration-normal) var(--ab-ease-out),
                border-color var(--ab-duration-normal) var(--ab-ease-out);
  }

  .ab-card:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 3px;
    z-index: var(--ab-z-card-hover);
  }

  .ab-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--ab-shadow-4);
    z-index: var(--ab-z-card-hover);
  }

  .ab-atelier--visible .ab-card:hover {
    transform: translateY(-3px);
  }

  /* ─── Card Accent Bar ─── */
  .ab-card__accent {
    height: 3px;
    background: var(--card-color, var(--ab-amber));
    border-radius: var(--ab-radius-lg) var(--ab-radius-lg) 0 0;
    opacity: 0.7;
  }

  /* ─── Card Image ─── */
  .ab-card__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--ab-stone-100);
  }

  .ab-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ab-duration-slow) var(--ab-ease-out);
  }

  .ab-card:hover .ab-card__image {
    transform: scale(1.04);
  }

  .ab-card__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 50%, rgba(28, 25, 23, 0.08) 100%);
    pointer-events: none;
  }

  /* ─── Card Body ─── */
  .ab-card__body {
    padding: var(--ab-space-5) var(--ab-space-5) var(--ab-space-6);
  }

  .ab-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--ab-space-2);
    gap: var(--ab-space-3);
  }

  .ab-card__title {
    font-family: var(--ab-font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ab-stone-900);
    margin: 0;
    line-height: 1.3;
  }

  .ab-card__price {
    font-family: var(--ab-font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ab-stone-600);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ab-card__description {
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--ab-stone-500);
    line-height: 1.55;
    margin: 0 0 var(--ab-space-4);
  }

  /* ─── Ingredient Pills ─── */
  .ab-card__ingredients {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ab-space-2);
    margin-bottom: var(--ab-space-5);
  }

  .ab-pill {
    display: inline-flex;
    align-items: center;
    padding: var(--ab-space-1) var(--ab-space-3);
    background: var(--ab-stone-100);
    border: 1px solid var(--ab-stone-200);
    border-radius: var(--ab-radius-pill);
    font-family: var(--ab-font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--ab-stone-600);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* ─── Card Action Button ─── */
  .ab-card__action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ab-space-2);
    width: 100%;
    min-height: var(--ab-touch-min);
    padding: var(--ab-space-3) var(--ab-space-5);
    background: var(--ab-stone-900);
    color: var(--ab-stone-50);
    border: none;
    border-radius: var(--ab-radius-md);
    font-family: var(--ab-font-body);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background var(--ab-duration-fast) var(--ab-ease-out),
                transform var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-card__action:hover {
    background: var(--ab-stone-800);
  }

  .ab-card__action:active {
    transform: scale(0.97);
  }

  .ab-card__action-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform var(--ab-duration-normal) var(--ab-ease-spring);
  }

  .ab-card__action-check {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: none;
  }

  .ab-card__action-loading {
    display: none;
  }

  .ab-spinner {
    width: 18px;
    height: 18px;
    animation: ab-spin 0.8s linear infinite;
  }

  @keyframes ab-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ─── Card Loading State ─── */
  .ab-card--loading .ab-card__action-text { display: none; }
  .ab-card--loading .ab-card__action-icon { display: none; }
  .ab-card--loading .ab-card__action-loading { display: flex; }

  /* ─── Card Selected State ─── */
  .ab-card--selected {
    border-color: var(--ab-amber);
    box-shadow: var(--ab-shadow-3), 0 0 0 1px var(--ab-amber-light);
  }

  .ab-card--selected .ab-card__accent {
    opacity: 1;
  }

  .ab-card--selected .ab-card__action {
    background: var(--ab-amber);
    color: white;
  }

  .ab-card--selected .ab-card__action-text { content: 'Added'; }
  .ab-card--selected .ab-card__action-icon { display: none; }
  .ab-card--selected .ab-card__action-check {
    display: block;
    animation: ab-check-in var(--ab-duration-normal) var(--ab-ease-spring);
  }

  @keyframes ab-check-in {
    from { transform: scale(0) rotate(-45deg); opacity: 0; }
    to { transform: scale(1) rotate(0deg); opacity: 1; }
  }

  /* ─── Explore Button ─── */
  .ab-card__explore {
    position: absolute;
    bottom: var(--ab-space-5);
    right: var(--ab-space-5);
    display: flex;
    align-items: center;
    gap: var(--ab-space-1);
    padding: var(--ab-space-2) var(--ab-space-3);
    min-height: var(--ab-touch-min);
    min-width: var(--ab-touch-min);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--ab-stone-200);
    border-radius: var(--ab-radius-pill);
    font-family: var(--ab-font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ab-stone-700);
    cursor: pointer;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--ab-duration-fast) var(--ab-ease-out),
                transform var(--ab-duration-fast) var(--ab-ease-out),
                background var(--ab-duration-fast) var(--ab-ease-out);
    z-index: 2;
  }

  .ab-card__explore svg {
    width: 14px;
    height: 14px;
  }

  .ab-card:hover .ab-card__explore,
  .ab-card:focus-within .ab-card__explore {
    opacity: 1;
    transform: translateY(0);
  }

  .ab-card__explore:hover {
    background: white;
    border-color: var(--ab-stone-300);
  }

  .ab-card__explore:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 2px;
    opacity: 1;
    transform: translateY(0);
  }

  /* Always show explore on touch devices */
  @media (hover: none) {
    .ab-card__explore {
      opacity: 1;
      transform: translateY(0);
      position: relative;
      bottom: auto;
      right: auto;
      margin: 0 var(--ab-space-5) var(--ab-space-5);
      width: fit-content;
    }
  }
  /* ============================================
     SIDEBAR — 380px Sticky Panel
     ============================================ */

  .ab-sidebar {
    position: sticky;
    top: var(--ab-space-8);
    width: var(--ab-sidebar-width);
    flex-shrink: 0;
    background: white;
    border-radius: var(--ab-radius-xl);
    box-shadow: var(--ab-shadow-3);
    padding: var(--ab-space-6);
    display: none;
    flex-direction: column;
    gap: var(--ab-space-5);
    max-height: calc(100vh - var(--ab-space-16));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--ab-stone-300) transparent;
  }

  @media (min-width: 1024px) {
    .ab-sidebar {
      display: flex;
    }
  }

  .ab-sidebar__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--ab-space-4);
    border-bottom: 1px solid var(--ab-stone-200);
  }

  .ab-sidebar__title {
    font-family: var(--ab-font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ab-stone-900);
    margin: 0;
  }

  /* ─── Synergy Ring ─── */
  .ab-sidebar__synergy-ring {
    position: relative;
    width: 56px;
    height: 56px;
  }

  .ab-sidebar__synergy-ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .ab-sidebar__ring-track {
    stroke: var(--ab-stone-200);
  }

  .ab-sidebar__ring-progress {
    stroke: var(--ab-amber);
    stroke-dasharray: 264;
    stroke-dashoffset: 264;
    stroke-linecap: round;
    transition: stroke-dashoffset var(--ab-duration-slow) var(--ab-ease-organic);
  }

  .ab-sidebar__ring-value {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--ab-font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ab-stone-700);
  }

  /* ─── Empty State ─── */
  .ab-sidebar__empty {
    text-align: center;
    padding: var(--ab-space-10) var(--ab-space-4);
  }

  .ab-sidebar__empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--ab-space-4);
    color: var(--ab-stone-400);
  }

  .ab-sidebar__empty-icon svg {
    width: 100%;
    height: 100%;
  }

  .ab-sidebar__empty-text {
    font-size: 0.875rem;
    color: var(--ab-stone-400);
    line-height: 1.6;
    margin: 0;
  }

  /* ─── Synergy Visualization ─── */
  .ab-sidebar__synergy-viz {
    padding: var(--ab-space-4) 0;
    border-bottom: 1px solid var(--ab-stone-200);
  }

  .ab-synergy-svg {
    width: 100%;
    height: auto;
  }

  .ab-synergy__connection {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.7;
    transition: opacity var(--ab-duration-normal) var(--ab-ease-out);
  }

  .ab-synergy__score-badge {
    font-family: var(--ab-font-mono);
    font-size: 9px;
    font-weight: 500;
  }

  .ab-synergy__node {
    cursor: pointer;
    outline: none;
  }

  .ab-synergy__node:focus-visible circle:first-child {
    stroke: var(--ab-amber);
    stroke-width: 3;
  }

  .ab-synergy__center-score {
    font-family: var(--ab-font-mono);
    font-size: 14px;
    font-weight: 600;
    fill: var(--ab-stone-800);
  }

  /* ─── Selected Items List ─── */
  .ab-sidebar__items {
    display: flex;
    flex-direction: column;
    gap: var(--ab-space-2);
  }

  .ab-sidebar__item {
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    padding: var(--ab-space-3);
    background: var(--ab-stone-50);
    border-radius: var(--ab-radius-md);
    transition: background var(--ab-duration-fast) var(--ab-ease-out);
    animation: ab-item-in var(--ab-duration-normal) var(--ab-ease-spring);
  }

  @keyframes ab-item-in {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .ab-sidebar__item:hover {
    background: var(--ab-stone-100);
  }

  .ab-sidebar__item-image {
    width: 44px;
    height: 44px;
    border-radius: var(--ab-radius-sm);
    object-fit: cover;
    flex-shrink: 0;
  }

  .ab-sidebar__item-info {
    flex: 1;
    min-width: 0;
  }

  .ab-sidebar__item-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ab-stone-800);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ab-sidebar__item-price {
    font-family: var(--ab-font-mono);
    font-size: 0.75rem;
    color: var(--ab-stone-500);
  }

  .ab-sidebar__item-remove {
    width: var(--ab-touch-min);
    height: var(--ab-touch-min);
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--ab-stone-400);
    cursor: pointer;
    border-radius: var(--ab-radius-sm);
    flex-shrink: 0;
    transition: color var(--ab-duration-fast) var(--ab-ease-out),
                background var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-sidebar__item-remove:hover {
    color: var(--ab-error);
    background: rgba(192, 112, 112, 0.1);
  }

  .ab-sidebar__item-remove:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 2px;
  }

  .ab-sidebar__item-remove svg {
    width: 16px;
    height: 16px;
  }

  /* ─── Tier Progress ─── */
  .ab-sidebar__tiers {
    padding: var(--ab-space-4) 0;
    border-top: 1px solid var(--ab-stone-200);
  }

  .ab-sidebar__tiers-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--ab-space-3);
  }

  .ab-sidebar__tiers-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ab-stone-600);
  }

  .ab-sidebar__tiers-current {
    font-family: var(--ab-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ab-amber);
    background: var(--ab-amber-light);
    padding: var(--ab-space-1) var(--ab-space-3);
    border-radius: var(--ab-radius-pill);
  }

  .ab-sidebar__tiers-track {
    position: relative;
    height: 6px;
    background: var(--ab-stone-200);
    border-radius: var(--ab-radius-pill);
    overflow: visible;
  }

  .ab-sidebar__tiers-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--ab-amber), var(--ab-gold));
    border-radius: var(--ab-radius-pill);
    width: 0%;
    transition: width var(--ab-duration-slow) var(--ab-ease-organic);
  }

  .ab-sidebar__tiers-steps {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
  }

  .ab-tier-step {
    font-family: var(--ab-font-mono);
    font-size: 0.6rem;
    color: var(--ab-stone-400);
    transform: translateY(14px);
    white-space: nowrap;
  }

  .ab-tier-step--active {
    color: var(--ab-amber);
    font-weight: 600;
  }

  /* ─── Pricing ─── */
  .ab-sidebar__pricing {
    padding-top: var(--ab-space-4);
    border-top: 1px solid var(--ab-stone-200);
    display: flex;
    flex-direction: column;
    gap: var(--ab-space-2);
  }

  .ab-sidebar__price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--ab-stone-600);
  }

  .ab-sidebar__price-row--discount {
    color: var(--ab-success);
  }

  .ab-sidebar__price-row--total {
    font-weight: 600;
    color: var(--ab-stone-900);
    font-size: 1rem;
    padding-top: var(--ab-space-2);
    border-top: 1px solid var(--ab-stone-200);
    margin-top: var(--ab-space-1);
  }

  .ab-sidebar__subtotal,
  .ab-sidebar__discount,
  .ab-sidebar__total {
    font-family: var(--ab-font-mono);
    font-weight: 500;
  }

  /* ─── Checkout Button ─── */
  .ab-sidebar__checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ab-space-3);
    width: 100%;
    min-height: 52px;
    padding: var(--ab-space-4) var(--ab-space-6);
    background: var(--ab-stone-900);
    color: white;
    border: none;
    border-radius: var(--ab-radius-md);
    font-family: var(--ab-font-body);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background var(--ab-duration-fast) var(--ab-ease-out),
                transform var(--ab-duration-fast) var(--ab-ease-out),
                opacity var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-sidebar__checkout:hover:not(:disabled) {
    background: var(--ab-stone-800);
    transform: translateY(-1px);
  }

  .ab-sidebar__checkout:active:not(:disabled) {
    transform: scale(0.98);
  }

  .ab-sidebar__checkout:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .ab-sidebar__checkout:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 3px;
  }

  .ab-sidebar__checkout svg {
    width: 18px;
    height: 18px;
    transition: transform var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-sidebar__checkout:hover:not(:disabled) svg {
    transform: translateX(3px);
  }

  /* ============================================
     MOBILE DOCK
     ============================================ */

  .ab-dock {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--ab-z-dock);
    background: white;
    border-radius: var(--ab-radius-xl) var(--ab-radius-xl) 0 0;
    box-shadow: 0 -4px 24px rgba(28, 25, 23, 0.1);
    transition: transform var(--ab-duration-normal) var(--ab-ease-organic);
    display: block;
  }

  @media (min-width: 1024px) {
    .ab-dock {
      display: none;
    }
  }

  .ab-dock__handle {
    display: flex;
    justify-content: center;
    padding: var(--ab-space-3) 0 var(--ab-space-1);
    cursor: grab;
  }

  .ab-dock__handle span {
    width: 40px;
    height: 4px;
    background: var(--ab-stone-300);
    border-radius: var(--ab-radius-pill);
  }

  /* ─── Collapsed View ─── */
  .ab-dock__collapsed {
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    padding: 0 var(--ab-space-5) var(--ab-space-4);
    min-height: 52px;
  }

  .ab-dock__preview {
    flex: 1;
    min-width: 0;
  }

  .ab-dock__empty-text {
    font-size: 0.85rem;
    color: var(--ab-stone-400);
    font-weight: 400;
  }

  .ab-dock__thumbnails {
    display: flex;
    gap: var(--ab-space-1);
  }

  .ab-dock__thumbnail {
    width: 32px;
    height: 32px;
    border-radius: var(--ab-radius-sm);
    object-fit: cover;
    border: 1.5px solid white;
    box-shadow: var(--ab-shadow-1);
  }

  .ab-dock__info {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    flex-shrink: 0;
  }

  .ab-dock__count {
    font-size: 0.75rem;
    color: var(--ab-stone-500);
    font-weight: 500;
  }

  .ab-dock__tier-badge {
    font-family: var(--ab-font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--ab-amber);
    background: var(--ab-amber-light);
    padding: 1px var(--ab-space-2);
    border-radius: var(--ab-radius-pill);
  }

  .ab-dock__mini-total {
    font-family: var(--ab-font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ab-stone-900);
    flex-shrink: 0;
  }

  .ab-dock__expand {
    width: var(--ab-touch-min);
    height: var(--ab-touch-min);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ab-stone-100);
    border: none;
    border-radius: var(--ab-radius-circle);
    color: var(--ab-stone-600);
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-dock__expand:hover {
    background: var(--ab-stone-200);
  }

  .ab-dock__expand:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 2px;
  }

  .ab-dock__expand svg {
    width: 18px;
    height: 18px;
  }

  /* ─── Expanded View ─── */
  .ab-dock__expanded {
    display: none;
    flex-direction: column;
    gap: var(--ab-space-4);
    padding: 0 var(--ab-space-5) var(--ab-space-4);
    max-height: 75vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .ab-dock--open .ab-dock__collapsed {
    display: none;
  }

  .ab-dock--open .ab-dock__expanded {
    display: flex;
  }

  .ab-dock__expanded-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ab-dock__expanded-header h3 {
    font-family: var(--ab-font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ab-stone-900);
    margin: 0;
  }

  .ab-dock__close {
    width: var(--ab-touch-min);
    height: var(--ab-touch-min);
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--ab-stone-500);
    cursor: pointer;
    border-radius: var(--ab-radius-sm);
    transition: color var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-dock__close:hover {
    color: var(--ab-stone-800);
  }

  .ab-dock__close:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 2px;
  }

  .ab-dock__close svg {
    width: 20px;
    height: 20px;
  }

  /* ─── Dock Synergy ─── */
  .ab-dock__synergy {
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    padding: var(--ab-space-3) 0;
  }

  .ab-dock__synergy-circle {
    position: relative;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }

  .ab-dock__synergy-circle svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .ab-dock__ring-track {
    stroke: var(--ab-stone-200);
  }

  .ab-dock__ring-progress {
    stroke: var(--ab-amber);
    stroke-dasharray: 201;
    stroke-dashoffset: 201;
    stroke-linecap: round;
    transition: stroke-dashoffset var(--ab-duration-slow) var(--ab-ease-organic);
  }

  .ab-dock__synergy-value {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--ab-font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--ab-stone-700);
  }

  .ab-dock__synergy-label {
    font-size: 0.8rem;
    color: var(--ab-stone-500);
  }

  /* ─── Dock Items ─── */
  .ab-dock__items {
    display: flex;
    flex-direction: column;
    gap: var(--ab-space-2);
  }

  .ab-dock__item {
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    padding: var(--ab-space-2) var(--ab-space-3);
    background: var(--ab-stone-50);
    border-radius: var(--ab-radius-sm);
  }

  .ab-dock__item-image {
    width: 36px;
    height: 36px;
    border-radius: var(--ab-radius-xs);
    object-fit: cover;
    flex-shrink: 0;
  }

  .ab-dock__item-title {
    flex: 1;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ab-stone-800);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ab-dock__item-price {
    font-family: var(--ab-font-mono);
    font-size: 0.7rem;
    color: var(--ab-stone-500);
    flex-shrink: 0;
  }

  .ab-dock__item-remove {
    width: var(--ab-touch-min);
    height: var(--ab-touch-min);
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--ab-stone-400);
    cursor: pointer;
    flex-shrink: 0;
    border-radius: var(--ab-radius-xs);
  }

  .ab-dock__item-remove:hover {
    color: var(--ab-error);
  }

  .ab-dock__item-remove:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 2px;
  }

  .ab-dock__item-remove svg {
    width: 14px;
    height: 14px;
  }

  /* ─── Dock Tiers ─── */
  .ab-dock__tiers {
    padding: var(--ab-space-3) 0;
  }

  .ab-dock__tiers-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--ab-stone-500);
    margin-bottom: var(--ab-space-2);
  }

  .ab-dock__tiers-current {
    font-family: var(--ab-font-mono);
    color: var(--ab-amber);
    font-weight: 500;
  }

  .ab-dock__tiers-track {
    height: 4px;
    background: var(--ab-stone-200);
    border-radius: var(--ab-radius-pill);
    overflow: hidden;
  }

  .ab-dock__tiers-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--ab-amber), var(--ab-gold));
    border-radius: var(--ab-radius-pill);
    width: 0%;
    transition: width var(--ab-duration-slow) var(--ab-ease-organic);
  }

  /* ─── Dock Pricing ─── */
  .ab-dock__pricing {
    display: flex;
    flex-direction: column;
    gap: var(--ab-space-2);
    padding-top: var(--ab-space-3);
    border-top: 1px solid var(--ab-stone-200);
  }

  .ab-dock__price-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--ab-stone-600);
  }

  .ab-dock__price-row--discount {
    color: var(--ab-success);
  }

  .ab-dock__price-row--total {
    font-weight: 600;
    color: var(--ab-stone-900);
    padding-top: var(--ab-space-2);
    border-top: 1px solid var(--ab-stone-200);
  }

  .ab-dock__subtotal,
  .ab-dock__discount,
  .ab-dock__net-total {
    font-family: var(--ab-font-mono);
    font-weight: 500;
  }

  /* ─── Dock Footer ─── */
  .ab-dock__footer {
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    padding: var(--ab-space-3) var(--ab-space-5) var(--ab-space-4);
    padding-bottom: max(var(--ab-space-4), env(safe-area-inset-bottom));
    border-top: 1px solid var(--ab-stone-200);
    background: white;
  }

  .ab-dock--empty .ab-dock__footer {
    display: none;
  }

  .ab-dock__footer-total {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
  }

  .ab-dock__footer-label {
    font-size: 0.65rem;
    color: var(--ab-stone-400);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ab-dock__footer-value {
    font-family: var(--ab-font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ab-stone-900);
  }

  .ab-dock__checkout {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ab-space-2);
    min-height: var(--ab-touch-min);
    padding: var(--ab-space-3) var(--ab-space-5);
    background: var(--ab-stone-900);
    color: white;
    border: none;
    border-radius: var(--ab-radius-md);
    font-family: var(--ab-font-body);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background var(--ab-duration-fast) var(--ab-ease-out),
                opacity var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-dock__checkout:hover:not(:disabled) {
    background: var(--ab-stone-800);
  }

  .ab-dock__checkout:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .ab-dock__checkout:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 2px;
  }

  .ab-dock__checkout svg {
    width: 16px;
    height: 16px;
  }

  /* ============================================
     PRODUCT DETAIL MODAL
     ============================================ */

  .ab-modal {
    position: fixed;
    inset: 0;
    z-index: var(--ab-z-modal);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    visibility: hidden;
    pointer-events: none;
  }

  .ab-modal--open {
    visibility: visible;
    pointer-events: auto;
  }

  .ab-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 25, 23, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--ab-duration-normal) var(--ab-ease-out);
    z-index: var(--ab-z-modal-backdrop);
  }

  .ab-modal--open .ab-modal__backdrop {
    opacity: 1;
  }

  .ab-modal__panel {
    position: relative;
    z-index: var(--ab-z-modal);
    width: 100%;
    max-height: 95vh;
    background: white;
    border-radius: var(--ab-radius-xl) var(--ab-radius-xl) 0 0;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform var(--ab-duration-normal) var(--ab-ease-organic);
    overflow: hidden;
  }

  .ab-modal--open .ab-modal__panel {
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .ab-modal {
      align-items: center;
      padding: var(--ab-space-8);
    }

    .ab-modal__panel {
      max-width: 560px;
      max-height: 85vh;
      border-radius: var(--ab-radius-xl);
      transform: translateY(24px) scale(0.97);
      opacity: 0;
      transition: transform var(--ab-duration-normal) var(--ab-ease-organic),
                  opacity var(--ab-duration-normal) var(--ab-ease-out);
    }

    .ab-modal--open .ab-modal__panel {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  .ab-modal__header {
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    padding: var(--ab-space-4) var(--ab-space-5);
    border-bottom: 1px solid var(--ab-stone-200);
    flex-shrink: 0;
  }

  .ab-modal__title {
    flex: 1;
    font-family: var(--ab-font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ab-stone-900);
    margin: 0;
    text-align: center;
  }

  .ab-modal__back,
  .ab-modal__close {
    width: var(--ab-touch-min);
    height: var(--ab-touch-min);
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--ab-stone-500);
    cursor: pointer;
    border-radius: var(--ab-radius-sm);
    flex-shrink: 0;
    transition: color var(--ab-duration-fast) var(--ab-ease-out),
                background var(--ab-duration-fast) var(--ab-ease-out);
  }

  .ab-modal__back:hover,
  .ab-modal__close:hover {
    color: var(--ab-stone-800);
    background: var(--ab-stone-100);
  }

  .ab-modal__back:focus-visible,
  .ab-modal__close:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: 2px;
  }

  .ab-modal__back svg,
  .ab-modal__close svg {
    width: 20px;
    height: 20px;
  }

  /* ─── Modal Scroll Area ─── */
  .ab-modal__scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ─── Modal Hero ─── */
  .ab-modal__hero {
    position: relative;
    background: var(--ab-stone-100);
    padding: var(--ab-space-6);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ab-modal__image {
    width: 200px;
    height: 200px;
    object-fit: contain;
    border-radius: var(--ab-radius-md);
  }

  .ab-modal__timing {
    position: absolute;
    bottom: var(--ab-space-3);
    right: var(--ab-space-4);
    font-family: var(--ab-font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ab-stone-500);
    background: rgba(255, 255, 255, 0.8);
    padding: var(--ab-space-1) var(--ab-space-3);
    border-radius: var(--ab-radius-pill);
  }

  /* ─── Modal Tabs ─── */
  .ab-modal__tabs {
    display: flex;
    position: relative;
    border-bottom: 1px solid var(--ab-stone-200);
    padding: 0 var(--ab-space-5);
  }

  .ab-modal__tab {
    flex: 1;
    min-height: var(--ab-touch-min);
    padding: var(--ab-space-3) var(--ab-space-2);
    background: none;
    border: none;
    font-family: var(--ab-font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ab-stone-400);
    cursor: pointer;
    transition: color var(--ab-duration-fast) var(--ab-ease-out);
    position: relative;
    z-index: 1;
  }

  .ab-modal__tab:hover {
    color: var(--ab-stone-600);
  }

  .ab-modal__tab--active {
    color: var(--ab-stone-900);
  }

  .ab-modal__tab:focus-visible {
    outline: 2px solid var(--ab-amber);
    outline-offset: -2px;
    border-radius: var(--ab-radius-xs);
  }

  .ab-modal__tab-indicator {
    position: absolute;
    bottom: 0;
    height: 2px;
    background: var(--ab-amber);
    border-radius: var(--ab-radius-pill);
    transition: left var(--ab-duration-normal) var(--ab-ease-organic),
                width var(--ab-duration-normal) var(--ab-ease-organic);
  }

  /* ─── Modal Body ─── */
  .ab-modal__body {
    padding: var(--ab-space-5);
    min-height: 200px;
  }

  .ab-modal__tab-panel {
    animation: ab-tab-fade var(--ab-duration-fast) var(--ab-ease-out);
  }

  @keyframes ab-tab-fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Benefits */
  .ab-benefit {
    display: flex;
    align-items: flex-start;
    gap: var(--ab-space-3);
    padding: var(--ab-space-3) 0;
  }

  .ab-benefit + .ab-benefit {
    border-top: 1px solid var(--ab-stone-100);
  }

  .ab-benefit__icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ab-stone-100);
    border-radius: var(--ab-radius-sm);
    font-size: 1rem;
    flex-shrink: 0;
  }

  .ab-benefit__text {
    font-size: 0.875rem;
    color: var(--ab-stone-700);
    line-height: 1.5;
    padding-top: 4px;
  }

  /* Ingredients */
  .ab-ingredient {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--ab-space-3) 0;
  }

  .ab-ingredient + .ab-ingredient {
    border-top: 1px solid var(--ab-stone-100);
  }

  .ab-ingredient__name {
    font-size: 0.875rem;
    color: var(--ab-stone-800);
    font-weight: 500;
  }

  .ab-ingredient__amount {
    font-family: var(--ab-font-mono);
    font-size: 0.8rem;
    color: var(--ab-stone-500);
    font-weight: 500;
  }

  /* Science */
  .ab-science-text {
    font-size: 0.875rem;
    color: var(--ab-stone-600);
    line-height: 1.7;
  }

  /* Synergy List in Modal */
  .ab-synergy-pair {
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    padding: var(--ab-space-3) 0;
  }

  .ab-synergy-pair + .ab-synergy-pair {
    border-top: 1px solid var(--ab-stone-100);
  }

  .ab-synergy-pair__score {
    font-family: var(--ab-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ab-amber);
    background: var(--ab-amber-light);
    padding: var(--ab-space-1) var(--ab-space-2);
    border-radius: var(--ab-radius-pill);
    flex-shrink: 0;
    min-width: 40px;
    text-align: center;
  }

  .ab-synergy-pair__info {
    flex: 1;
  }

  .ab-synergy-pair__name {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ab-stone-800);
    margin-bottom: 2px;
  }

  .ab-synergy-pair__reason {
    font-size: 0.75rem;
    color: var(--ab-stone-500);
    line-height: 1.4;
  }

  /* ─── Modal Footer ─── */
  .ab-modal__footer {
    padding: var(--ab-space-4) var(--ab-space-5);
    padding-bottom: max(var(--ab-space-4), env(safe-area-inset-bottom));
    border-top: 1px solid var(--ab-stone-200);
    display: flex;
    align-items: center;
    gap: var(--ab-space-3);
    flex-shrink: 0;
    background: white;
  }

  .ab-modal__add {
    flex: 1;
    min-height: var(--ab-touch-min);
    padding: var(--ab-space-3) var(--ab-space-5);
    background: var(--ab-stone-900);
    color: white;
